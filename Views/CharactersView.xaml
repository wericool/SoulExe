<UserControl x:Class="SoulExe.Views.CharactersView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SoulExe">
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <!-- Прежний список скрыт: создание, импорт и выбор персонажа теперь находятся в Библиотеке. -->
        <Border Visibility="Collapsed" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,12">
                                <TextBlock Text="{DynamicResource S.Character.Editor.Characters}" FontSize="15" FontWeight="SemiBold" />
                                <TextBlock Text="{DynamicResource S.Character.Editor.CardLibrary}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,3,0,0" />
                            </StackPanel>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{StaticResource CardGradientBrush}" CornerRadius="10" Padding="10" Margin="0,2">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Grid Width="34" Height="34">
                                                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                    <TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="11" Foreground="White" />
                                                    <Ellipse IsHitTestVisible="False">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <Button Content="{DynamicResource S.Character.Editor.Create}" Command="{Binding AddCharacterCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                <Button Content="{DynamicResource S.Character.Editor.Generate}" Command="{Binding ToggleCharacterGeneratorCommand}" Style="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,6">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCharacterGeneratorOpen}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.CharacterIdea}" Style="{StaticResource SectionLabel}" />
                                        <TextBox Text="{Binding CharacterGenerationIdea, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" Margin="0,8,0,0" />
                                        <Button Content="{DynamicResource S.Character.Editor.Generate}" Command="{Binding GenerateCharacterFromIdeaCommand}" Style="{StaticResource SuccessButton}" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
                                    </StackPanel>
                                </Border>
                                <Button Content="{DynamicResource S.Character.Editor.ImportCard}" Command="{Binding ImportCharacterCommand}" Style="{StaticResource CompactButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                <Button Content="{DynamicResource S.Character.Editor.ImportSoul}" Command="{Binding ImportSoulOfWaifuCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch" Margin="0,0,0,6" />
                                <Button Content="{DynamicResource S.Character.Editor.Delete}" Command="{Binding DeleteCharacterCommand}" Style="{StaticResource DangerButton}" HorizontalAlignment="Stretch" />
                            </StackPanel>
                        </Grid>
                    </Border>
<!-- Right: editor -->
                    <Grid Grid.Column="2" MinWidth="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" MinWidth="0">
                            <StackPanel>
                                    <Border Style="{StaticResource SheetSectionElevated}" Padding="18" Margin="0,0,0,14">
                                    <DockPanel LastChildFill="False">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{DynamicResource S.Character.Editor.BackToLibrary}" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource GhostButton}" Margin="0,0,8,0" />
                                            <Button Content="{DynamicResource S.Character.Editor.Export}" Command="{Binding ExportCharacterCommand}" Style="{StaticResource CompactButton}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Character.Editor.Title}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedCharacter.Name}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DockPanel>
                                    </Border>
                                    <!-- Segment tabs -->
                                    <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="14" Padding="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                                        <StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="{DynamicResource S.Character.Editor.Tabs}">
                                            <Button Content="{DynamicResource S.Character.Editor.TabInfo}" Command="{Binding SelectCharacterEditorTabCommand}" CommandParameter="info" Padding="16,9" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource S.Character.Editor.TabInfo}" AutomationProperties.HelpText="{DynamicResource S.Character.Editor.TabHelp}" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="3" AutomationProperties.ItemStatus="{DynamicResource S.Character.Editor.TabUnselected}" TabIndex="0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCharacterEditorInfoTab}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Character.Editor.TabSelected}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource S.Character.Editor.TabMemory}" Command="{Binding SelectCharacterEditorTabCommand}" CommandParameter="memory" Padding="16,9" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource S.Character.Editor.TabMemory}" AutomationProperties.HelpText="{DynamicResource S.Character.Editor.TabHelp}" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="3" AutomationProperties.ItemStatus="{DynamicResource S.Character.Editor.TabUnselected}" TabIndex="1">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCharacterEditorMemoryTab}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Character.Editor.TabSelected}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="{DynamicResource S.Character.Editor.TabLore}" Command="{Binding SelectCharacterEditorTabCommand}" CommandParameter="lore" Padding="16,9" Margin="0,0,6,0" AutomationProperties.Name="{DynamicResource S.Character.Editor.TabLore}" AutomationProperties.HelpText="{DynamicResource S.Character.Editor.TabHelp}" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="3" AutomationProperties.ItemStatus="{DynamicResource S.Character.Editor.TabUnselected}" TabIndex="2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                        <Setter Property="Background" Value="Transparent" />
                                                        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsCharacterEditorLoreTab}" Value="True">
                                                                <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Character.Editor.TabSelected}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCharacterEditorInfoTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource SheetSection}" Padding="14" Margin="0,0,0,18">
                                            <DockPanel LastChildFill="False">
                                                <Grid DockPanel.Dock="Left" Width="68" Height="68" Margin="0,0,14,0">
                                                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                    <TextBlock Text="{Binding SelectedCharacter.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="19" Foreground="White" />
                                                    <Ellipse IsHitTestVisible="False">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.Avatar}" Style="{StaticResource SectionLabel}" Margin="0,0,0,7" />
                                                    <Button Content="{DynamicResource S.Character.Editor.ChooseAvatar}" Command="{Binding ChooseAvatarCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Left" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetSection}" Padding="18">
                                        <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.Identity}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.IdentityHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,16" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.BasicDetails}" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.Name}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Отображаемое имя персонажа в чатах, библиотеке и списках." />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="12,10" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.CharacterAndScene}" Style="{StaticResource SectionLabel}" Margin="0,20,0,2" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.TitleField}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Коткая роль или статус персонажа (например «рыцарь ордена» или «одноклассница»). Показывается под именем." />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.Title, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="12,10" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.Description}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Кто этот персонаж: внешность, биография, важные факты. Модель использует текст как контекст образа." />
                                            <Button Content="✦" Command="{Binding ExpandCharacterFieldCommand}" CommandParameter="description" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" Padding="6,0" Margin="5,0,0,0" FontWeight="Bold" ToolTip="{DynamicResource S.Character.Editor.ExpandField}" AutomationProperties.Name="{DynamicResource S.Character.Editor.ExpandField}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,10" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.Personality}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Черты характера, манера речи, привычки. Помогает модели держать стабильный стиль ответов." />
                                            <Button Content="✦" Command="{Binding ExpandCharacterFieldCommand}" CommandParameter="personality" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" Padding="6,0" Margin="5,0,0,0" FontWeight="Bold" ToolTip="{DynamicResource S.Character.Editor.ExpandField}" AutomationProperties.Name="{DynamicResource S.Character.Editor.ExpandField}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.Personality, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,10" />
                                        </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetSection}" Padding="18">
                                        <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.VoiceAndScene}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.VoiceAndSceneHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="250" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{DynamicResource S.Character.Editor.PersonalityExpression}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <ui:HelpHint Hint="Определяет, как часто модель показывает качества из поля «Личность»: ярко, естественно или ненавязчиво. Не меняет описание и сценарий." />
                                            </StackPanel>
                                            <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedCharacter.PersonalityExpressionLevel}" SelectedValuePath="Tag">
                                                <ComboBoxItem Tag="vivid" Content="{DynamicResource S.Character.Editor.ExpressionVivid}" />
                                                <ComboBoxItem Tag="natural" Content="{DynamicResource S.Character.Editor.ExpressionNatural}" />
                                                <ComboBoxItem Tag="subtle" Content="{DynamicResource S.Character.Editor.ExpressionSubtle}" />
                                            </ComboBox>
                                        </Grid>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ExpressionHelp}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.Scenario}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Общая ситуация и сеттинг, в котором начинается или проходит диалог." />
                                            <Button Content="✦" Command="{Binding ExpandCharacterFieldCommand}" CommandParameter="scenario" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" Padding="6,0" Margin="5,0,0,0" FontWeight="Bold" ToolTip="{DynamicResource S.Character.Editor.ExpandField}" AutomationProperties.Name="{DynamicResource S.Character.Editor.ExpandField}" />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.Scenario, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="80" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,10" />
                                        <Border Style="{StaticResource SystemStatusCard}" Padding="14" Margin="0,16,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.NewChatProfile}" FontWeight="SemiBold" />
                                                    <ui:HelpHint Hint="Эти сведения копируются только при создании нового чата персонажа. В каждом существующем диалоге их можно изменить отдельно на вкладке «Память»." />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.NewChatProfileHelp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,9" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.InitialUserFacts}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBox Text="{Binding SelectedCharacter.DefaultUserProfile, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" ToolTip="{DynamicResource S.Character.Editor.InitialUserFactsExample}" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.InitialRelationship}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,9,0,0" />
                                                <TextBox Text="{Binding SelectedCharacter.DefaultRelationshipContext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="55" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" ToolTip="{DynamicResource S.Character.Editor.InitialRelationshipExample}" />
                                            </StackPanel>
                                        </Border>
                                        </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetSection}" Padding="18">
                                        <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.UserPersona}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.UserPersonaHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,14" />
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Content="{DynamicResource S.Character.Editor.UseUserPersona}" IsChecked="{Binding IsSelectedCharacterPersonaEnabled}" FontWeight="SemiBold" />
                                                    <ui:HelpHint Hint="Персона — сохранённый образ пользователя: имя, роль, характер, биография и важные факты. При включении её текст добавляется в системный контекст перед историей чата, поэтому персонаж лучше понимает, кто вы. Отношения в поле выше остаются отдельным начальным контекстом конкретного чата." />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.PersonaSelectionHelp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                <StackPanel Margin="0,10,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSelectedCharacterPersonaEnabled}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.ActivePersona}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                    <ComboBox ItemsSource="{Binding Personas}" SelectedValue="{Binding SelectedCharacterPersonaId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="Name" Margin="0,5,0,0" MinHeight="42" ToolTip="{DynamicResource S.Character.Editor.ChoosePersona}" />
                                                    <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="0,9,0,0">
                                                        <TextBlock Text="{Binding SelectedCharacterPersonaDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                                    </Border>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource SheetSectionElevated}" Padding="18">
                                        <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ResponseDirection}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ResponseDirectionHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,14" />
                                        <Border Style="{StaticResource SystemStatusCard}" Padding="14">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.SystemPreset}" FontWeight="SemiBold" />
                                                    <ui:HelpHint Hint="Пресет задаёт общий режим ответа: обычный ролеплей, приключение, короткий диалог или постоянный русский язык. Он дополняет карточку, а не заменяет её." />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.SystemPresetHelp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,8" />
                                                <ComboBox ItemsSource="{Binding PromptPresetOptions}" SelectedValue="{Binding SelectedCharacterPromptPresetId, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" MinHeight="42">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="2">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="430" Margin="0,2,0,3" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="0,9,0,0">
                                                    <TextBlock Text="{Binding SelectedPromptPresetDescription}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" />
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.SystemPrompt}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Инструкции для модели: правила поведения, запреты, формат ответа. Самый сильный рычаг управления персонажем." />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.SystemPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,10" />
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.ReplyLanguage}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Например: Русский, English, 日本語. Или «Любой язык» — тогда модель следует языку текущего диалога." />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.ReplyLanguage, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" Padding="12,10" ToolTip="{DynamicResource S.Character.Editor.ReplyLanguageOptions}" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ReplyLanguageHint}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0" />
                                        <Border Style="{StaticResource SystemStatusCard}" Padding="14" Margin="0,16,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <CheckBox Content="{DynamicResource S.Character.Editor.RoleplayFormat}" IsChecked="{Binding SelectedCharacter.UseRoleplayResponseFormatting}" FontWeight="SemiBold" />
                                                    <ui:HelpHint Hint="Добавляет к системному контексту готовое правило формата, не изменяя ваш текст системного промпта." />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.RoleplayFormatHelp}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="25,6,0,8" />
                                                <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="25,0,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.RoleplayExampleAction}" FontStyle="Italic" Foreground="{StaticResource AccentHoverBrush}" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.RoleplayExampleLine}" Margin="0,10,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <TextBlock Text="{DynamicResource S.Character.Editor.ExampleDialogue}" VerticalAlignment="Center" />
                                            <ui:HelpHint Hint="Образцы реплик в формате диалога. Показывают модели желаемый тон и длину ответов." />
                                        </StackPanel>
                                        <TextBox Text="{Binding SelectedCharacter.ExampleDialogue, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="88" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" Padding="12,10" />
                                        </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
