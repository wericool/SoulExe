                                                    <DataTrigger Binding="{Binding IsCharacterEditorMemoryTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource SheetSection}" Padding="18">
                                            <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.MemoryTitle}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.MemoryHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,16" />
                                        <Border Style="{StaticResource SystemStatusCard}" Padding="14">
                                            <StackPanel>
                                                <CheckBox Content="{DynamicResource S.Character.Editor.CognitiveArchitecture}" IsChecked="{Binding SelectedCharacterCognitiveArchitectureEnabled}" FontWeight="SemiBold" ToolTip="{DynamicResource S.Character.Editor.CognitiveHelp}" />
                                                <TextBlock Text="{Binding SelectedCharacterCognitiveStatus}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" Margin="25,6,0,10" />
                                                <Grid Margin="25,0,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{DynamicResource S.Character.Editor.SoulMemory}" IsChecked="{Binding SelectedCharacterSoulMemoryEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{DynamicResource S.Character.Editor.SoulMemoryHelp}" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding SoulMemoryPresets}" SelectedValuePath="Id" SelectedValue="{Binding SelectedCharacterSoulMemoryPreset}" ToolTip="{DynamicResource S.Character.Editor.SoulMemoryPresetTooltip}">
                                                        <ComboBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <StackPanel Margin="2">
                                                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                                                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" MaxWidth="260" />
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ComboBox.ItemTemplate>
                                                    </ComboBox>
                                                    <TextBox Grid.Column="2" Text="{Binding SelectedCharacterSoulMemoryIntervalMessages, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="8,0,0,0" ToolTip="{DynamicResource S.Character.Editor.SoulMemoryIntervalHelp}" />
                                                </Grid>
                                                <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="25,9,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SoulMemoryPresets}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SoulMemoryFull}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,6,0,0" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SoulMemoryIndexDiary}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SoulMemoryIndexOnly}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SoulMemoryDiaryOnly}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,4,0,0" />
                                                    </StackPanel>
                                                </Border>
                                                <Grid Margin="25,9,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="230" />
                                                        <ColumnDefinition Width="72" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Content="{DynamicResource S.Character.Editor.AutoSummary}" IsChecked="{Binding SelectedCharacterAutoSummaryEnabled}" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{DynamicResource S.Character.Editor.AutoSummaryHelp}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.SummaryInterval}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                                        <ui:HelpHint Hint="Количество новых реплик диалога между автоматическими обновлениями Summary. Считаются и ваши сообщения, и ответы персонажа." />
                                                    </StackPanel>
                                                    <TextBox Grid.Column="2" Text="{Binding SelectedCharacterAutoSummaryIntervalMessages, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="8,0,0,0" ToolTip="{DynamicResource S.Character.Editor.SummaryIntervalHelp}" />
                                                </Grid>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.MemoryIntervalNote}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="25,8,0,0" />
                                                <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="25,12,0,0">
                                                    <StackPanel>
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.BackgroundUpdate}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <TextBlock Text="{DynamicResource S.Character.Editor.BackgroundUpdateHelp}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,5,0,8" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="150" />
                                                                <ColumnDefinition Width="78" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{DynamicResource S.Character.Editor.Mode}" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                            <ComboBox Grid.Column="1" SelectedValue="{Binding CognitiveBackgroundMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag">
                                                                <ComboBoxItem Tag="idle" Content="{DynamicResource S.Character.Editor.AfterPause}" />
                                                            </ComboBox>
                                                            <TextBox Grid.Column="2" Text="{Binding CognitiveBackgroundIdleSeconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" Margin="8,0,0,0" ToolTip="{DynamicResource S.Character.Editor.BackgroundDelayHelp}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding CognitiveBackgroundStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ChatContext}" Style="{StaticResource SectionLabel}" Margin="0,20,0,8" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ChatContextHelp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Chats}" SelectedItem="{Binding SelectedChat}" DisplayMemberPath="Name" ToolTip="{DynamicResource S.Character.Editor.SelectChat}" />
                                            <Button Grid.Column="1" Content="{DynamicResource S.Character.Editor.UpdateMemory}" Command="{Binding UpdateMemoryCommand}" Background="{StaticResource AccentSoftBrush}" />
                                            <Button Grid.Column="2" Content="{DynamicResource S.Character.Editor.UpdateSummary}" Command="{Binding UpdateSummaryCommand}" Background="{StaticResource BorderStrongBrush}" />
                                        </Grid>
                                        <Border Style="{StaticResource SystemStatusCard}" Padding="14" Margin="0,12,0,0">
                                            <StackPanel>
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.StartingContext}" FontWeight="SemiBold" />
                                                    <ui:HelpHint Hint="Значения принадлежат только этому чату. Поздние сообщения, Summary и Soul Memory имеют приоритет, поэтому «незнакомец» станет историей после знакомства." />
                                                </StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.StartingContextHelp}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,5,0,9" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.InitialFacts}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                <TextBox Text="{Binding SelectedPersonalConversation.InitialUserProfile, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.InitialRelationship}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,9,0,0" />
                                                <TextBox Text="{Binding SelectedPersonalConversation.InitialRelationshipContext, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" VerticalScrollBarVisibility="Auto" Margin="0,5,0,0" />
                                                <Button Content="{DynamicResource S.Character.Editor.SaveChatContext}" Command="{Binding SaveChatStartingContextCommand}" Style="{StaticResource SuccessButton}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <TextBlock Text="{Binding CognitiveArchitectureStatus}" Foreground="{StaticResource AccentHoverBrush}" FontSize="10" TextWrapping="Wrap" Margin="2,8,2,0" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.ChatSummary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,14,0,3" />
                                        <TextBox Text="{Binding SelectedPersonalConversation.SummaryText, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.CharacterMemory}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,11,0,3" />
                                        <TextBox Text="{Binding SelectedPersonalConversation.Memory.CharacterMemory, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="105" VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.UserProfileAndRelations}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,11,0,3" />
                                        <TextBox Text="{Binding SelectedPersonalConversation.Memory.UserProfile, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.TopicsAndDiary}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,11,0,3" />
                                        <Border Padding="14" Margin="0,4,0,6">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <MultiDataTrigger>
                                                            <MultiDataTrigger.Conditions>
                                                                <Condition Binding="{Binding SelectedPersonalConversation.Memory.Topics.Count}" Value="0" />
                                                                <Condition Binding="{Binding SelectedPersonalConversation.Memory.Diary.Count}" Value="0" />
                                                            </MultiDataTrigger.Conditions>
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </MultiDataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{DynamicResource S.Character.Editor.MemoryEmptyTitle}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.MemoryEmptyHelp}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <ItemsControl ItemsSource="{Binding SelectedPersonalConversation.Memory.Topics}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="0,3">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Key}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                            <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl ItemsSource="{Binding SelectedPersonalConversation.Memory.Diary}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Content}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="6,6,6,0" FontStyle="Italic" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCharacterEditorLoreTab}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Border Style="{StaticResource SheetSection}" Padding="18">
                                            <StackPanel>
                                        <TextBlock Text="{DynamicResource S.Character.Editor.WorldTitle}" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock Text="{DynamicResource S.Character.Editor.WorldHelp}" Style="{StaticResource InlineHelp}" Margin="0,4,0,16" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox ItemsSource="{Binding Lorebooks}" SelectedItem="{Binding SelectedLorebook}" ToolTip="{DynamicResource S.Character.Editor.ChooseLorebook}">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <Button Grid.Column="1" Content="{DynamicResource S.Character.Editor.AddLorebook}" Command="{Binding AddLorebookCommand}" Style="{StaticResource AccentButton}" Padding="12,8" />
                                        </Grid>
                                        <!-- Пусто: нет выбранного лорбука -->
                                        <Border Padding="18" Margin="0,12,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLorebook}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBlock Text="{DynamicResource S.Character.Editor.Lorebook}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.NoLorebook}" FontWeight="SemiBold" FontSize="15" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                                <TextBlock Text="{DynamicResource S.Character.Editor.NoLorebookHelp}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" MaxWidth="420" />
                                            </StackPanel>
                                        </Border>
                                        <!-- Редактор выбранного лорбука -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedLorebook}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <CheckBox Content="{DynamicResource S.Character.Editor.UseLorebook}" IsChecked="{Binding IsSelectedLorebookBound}" Margin="0,12,0,0" />
                                            <TextBox Text="{Binding SelectedLorebook.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,9,0,0" ToolTip="{DynamicResource S.Character.Editor.LorebookName}" />
                                            <TextBox Text="{Binding SelectedLorebook.Description, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="55" VerticalScrollBarVisibility="Auto" Margin="0,7,0,0" ToolTip="{DynamicResource S.Character.Editor.LorebookDescription}" />
                                            <TextBlock Text="{DynamicResource S.Character.Editor.LorebookEntries}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,14,0,6" />
                                            <!-- Пустые записи -->
                                            <Border Padding="14" Margin="0,0,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding SelectedLorebook.Entries.Count}" Value="0">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.NoEntries}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{DynamicResource S.Character.Editor.NoEntriesHelp}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <ItemsControl ItemsSource="{Binding SelectedLorebook.Entries}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource GalleryCard}" Padding="10" Margin="0,3">
                                                            <StackPanel>
                                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="{DynamicResource S.Character.Editor.EntryName}" />
                                                                <TextBox Text="{Binding Content, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" Height="66" VerticalScrollBarVisibility="Auto" Margin="0,6,0,0" ToolTip="{DynamicResource S.Character.Editor.EntryContent}" />
                                                                <Grid Margin="0,8,0,0">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="10" />
                                                                        <ColumnDefinition Width="190" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <CheckBox Content="{DynamicResource S.Character.Editor.Enabled}" IsChecked="{Binding IsEnabled}" VerticalAlignment="Center" />
                                                                    <ComboBox Grid.Column="2" SelectedValue="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" ToolTip="{DynamicResource S.Character.Editor.EntryTriggerMode}">
                                                                        <ComboBoxItem Content="{DynamicResource S.Character.Editor.Always}" Tag="always" />
                                                                        <ComboBoxItem Content="{DynamicResource S.Character.Editor.ByKeywords}" Tag="keyword" />
                                                                    </ComboBox>
                                                                    <TextBox Grid.Column="3" Text="{Binding KeywordsText, UpdateSourceTrigger=PropertyChanged}" Margin="9,0,0,0" ToolTip="{DynamicResource S.Character.Editor.EntryKeywords}" />
                                                                </Grid>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                             <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                 <Button Content="{DynamicResource S.Character.Editor.AddLoreEntry}" Command="{Binding AddLoreEntryCommand}" Style="{StaticResource AccentButton}" />
                                                 <Button Content="{DynamicResource S.Character.Editor.SaveLorebook}" Command="{Binding SaveLorebookCommand}" Style="{StaticResource SuccessButton}" />
                                             </StackPanel>
                                             </StackPanel>
                                            </StackPanel>
                                         </Border>
</StackPanel>
                             </StackPanel>
                    </ScrollViewer>
                        <Border Grid.Row="0" Padding="24" IsHitTestVisible="False">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource EmptyState}">
                                    <Setter Property="Padding" Value="24" />
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCharacter}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                                <TextBlock Text="{DynamicResource S.Character.Editor.NoCharacterTitle}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" />
                                <TextBlock Text="{DynamicResource S.Character.Editor.NoCharacterHelp}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,16" />
                                <Button Content="{DynamicResource S.Character.Editor.OpenLibrary}" Command="{Binding NavigateCommand}" CommandParameter="Home" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" />
</StackPanel>
                        </Border>
                        <DockPanel Grid.Row="1" Margin="0,12,0,0">
                            <DockPanel.Style>
                                <Style TargetType="DockPanel">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SelectedCharacter}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <Button DockPanel.Dock="Right" Content="{DynamicResource S.Character.Editor.SaveCharacter}" Command="{Binding SaveCharacterCommand}" Style="{StaticResource SuccessButton}" Padding="20,11" />
                            <TextBlock Text="{DynamicResource S.Character.Editor.SaveHint}" Foreground="{StaticResource TextDimBrush}" FontSize="11" VerticalAlignment="Center" />
                        </DockPanel>
                    </Grid>
                    </Grid>
</UserControl>
