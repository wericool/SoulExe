                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border x:Name="PersonaDeleteDialog" Width="470" Background="{StaticResource PanelBrush}" BorderBrush="#E85A73" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                            <StackPanel>
                                <Border Width="46" Height="46" CornerRadius="14" Background="#3D1723" HorizontalAlignment="Left">
                                    <TextBlock Text="!" Foreground="{StaticResource DangerHoverBrush}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Text="Удалить персону?" FontSize="21" FontWeight="SemiBold" Margin="0,16,0,0" />
                                <TextBlock Text="{Binding PersonaPendingDeletion.Name, StringFormat=Персона «{0}» будет удалена из библиотеки.}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="12.5" Margin="0,7,0,0" />
                                <Border Background="#27151C" BorderBrush="#5A2736" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0">
                                    <TextBlock Text="Связанные персонажи не удаляются: у них будет только отключена эта персона, а история чатов останется сохранённой." Foreground="#F7BEC9" FontSize="11.5" TextWrapping="Wrap" />
                                </Border>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
                                    <Button x:Name="PersonaDeleteInitialFocus" Content="Отмена" Command="{Binding CancelPersonaDeleteCommand}" Style="{StaticResource GhostButton}" />
                                    <Button Content="Удалить навсегда" Command="{Binding DeletePersonaCommand}" Style="{StaticResource DangerButton}" Padding="16,9" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Border>
                    <Border Grid.RowSpan="3" Panel.ZIndex="50" Background="#C9090B14" CornerRadius="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPendingDeletionDialogOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border Width="470" Background="{StaticResource PanelBrush}" BorderBrush="#E85A73" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"><StackPanel><TextBlock Text="{Binding PendingDeletion.Title}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingDeletion.Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><Border Background="#27151C" BorderBrush="#5A2736" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding PendingDeletion.Warning}" Foreground="#F7BEC9" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="PendingDeletionInitialFocus" Content="Отмена" Command="{Binding CancelPendingDeletionCommand}" Style="{StaticResource GhostButton}"/><Button Content="Удалить навсегда" Command="{Binding ConfirmPendingDeletionCommand}" Style="{StaticResource DangerButton}" Padding="16,9" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
                    </Grid>
</UserControl>
