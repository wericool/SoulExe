<UserControl x:Class="SoulExe.Views.LibraryView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SoulExe" PreviewKeyDown="LibraryView_OnPreviewKeyDown" Loaded="LibraryView_OnLoaded" Unloaded="LibraryView_OnUnloaded">
    <UserControl.Resources>
        <LinearGradientBrush x:Key="LibraryCardScrimGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#00050507" Offset="0" />
            <GradientStop Color="#F1080A13" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="LibraryCardActionsOverlayBrush" Color="#DD0A0D19" />
        <Style x:Key="LibraryMetaChip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
    </UserControl.Resources>
    <Grid>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="0,0,0,16" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Вкладки библиотеки">
                            <Button Content="Персонажи" Command="{Binding SelectLibraryTabCommand}" CommandParameter="characters" Padding="16,9" Margin="0,0,4,0" AutomationProperties.Name="Персонажи" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="3" TabIndex="0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Лор" Command="{Binding SelectLibraryTabCommand}" CommandParameter="lore" Padding="16,9" AutomationProperties.Name="Лор" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="3" TabIndex="1">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryLoreTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Персоны" Command="{Binding SelectLibraryTabCommand}" CommandParameter="personas" Padding="16,9" Margin="4,0,0,0" AutomationProperties.Name="Персоны" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="3" TabIndex="2">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryPersonasTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <ComboBox ItemsSource="{Binding HomeCharacterSortOptions}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectedValue="{Binding HomeCharacterSortMode}" Width="180" FontSize="12" Margin="0,0,12,0" Style="{StaticResource LibrarySortCombo}" />
                                <TextBlock Text="Импорт" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <Button Content="Card V2" Command="{Binding ImportCharacterCommand}" Style="{StaticResource GhostButton}" Padding="11,7" Margin="0,0,8,0" ToolTip="Импорт Character Card V2 в формате PNG или JSON" />
                                <Button Content="Soul-of-Waifu" Command="{Binding ImportSoulOfWaifuCommand}" Style="{StaticResource GhostButton}" Padding="11,7" Margin="0,0,12,0" ToolTip="Импорт персонажей и данных из старой установки Soul-of-Waifu" />
                                <Button Content="＋ Новый персонаж" Command="{Binding OpenCharacterCreationDialogCommand}" Style="{StaticResource AccentButton}" Padding="13,8" />
                            </StackPanel>
                            <Button Content="＋ Новый лорбук" Command="{Binding AddLorebookCommand}" Padding="13,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryLoreTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="＋ Новая персона" Command="{Binding AddPersonaCommand}" Padding="13,8">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryPersonasTab}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Карточки персонажей" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Импорт, создание и быстрый запуск диалога с вашими персонажами." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HomeCards.Count}" Value="1">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="＋" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="В библиотеке пока нет персонажей" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="Создайте первую карточку вручную или с помощью локальной модели." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,14" TextAlignment="Center" HorizontalAlignment="Center" />
                                    <Button Content="Создать персонажа" Command="{Binding OpenCharacterCreationDialogCommand}" Style="{StaticResource AccentButton}" Padding="14,8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding HomeCards}">
                                <ItemsControl.Style>
                                    <Style TargetType="ItemsControl">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HomeCards.Count}" Value="1">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ItemsControl.Style>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="236" Height="280" Margin="0,0,16,16">
                                        <!-- Прямоугольная карточка персонажа. -->
                                        <Border x:Name="CharacterCard" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <Border Background="{StaticResource ElevatedBrush}">
                                                    <TextBlock Text="{Binding Character.Initials}" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Image Source="{Binding Character.AvatarPath}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Height="118" Background="{StaticResource LibraryCardScrimGradient}" />
                                                <StackPanel VerticalAlignment="Bottom" Margin="15,0,15,16">
                                                    <TextBlock Text="{Binding Character.Name}" FontWeight="SemiBold" FontSize="17" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Character.Title}" Foreground="{StaticResource CardScrimTextBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <!-- Никаких локальных Opacity: стиль гарантирует появление панели при наведении на всю карточку. -->
                                                <Border x:Name="CardActions" Background="{StaticResource LibraryCardActionsOverlayBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                 <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible" />
                                                                 </DataTrigger>
                                                                 <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                     <Setter Property="Visibility" Value="Visible" />
                                                                 </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                            <Button Content="✎" Command="{Binding DataContext.OpenCharacterEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="Редактировать персонажа" ToolTip="Редактировать персонажа" />
                                                            <Button Content="✕" Command="{Binding DataContext.ConfirmDeleteCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource CircleIconButtonDanger}" Margin="8,0,0,0" AutomationProperties.Name="Удалить персонажа" ToolTip="Удалить персонажа" />
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Character.Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                            <TextBlock Text="Открыть новый диалог" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,12" HorizontalAlignment="Center" />
                                                            <Button Content="▶  Новый чат" Command="{Binding DataContext.OpenCharacterChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource AccentButton}" Padding="15,9" ToolTip="Открыть чат с персонажем" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- Последняя карточка добавления в тех же размерах и прямоугольном стиле. -->
                                        <Button Command="{Binding DataContext.OpenCharacterCreationDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Создать нового персонажа" Padding="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
                                                    <Setter Property="BorderThickness" Value="1.5" />
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="AddCharacterCard" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter TargetName="AddCharacterCard" Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                                        <Setter TargetName="AddCharacterCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                                        <Setter TargetName="AddCharacterCard" Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                                    </Trigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="＋" FontSize="29" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Новый персонаж" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,13,0,0" HorizontalAlignment="Center" />
                                                <TextBlock Text="Создать карточку" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryLoreTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Загруженные лоры" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Миры, правила, места и события, доступные для привязки к персонажам." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lorebooks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="◫" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="Здесь появятся ваши лорбуки" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="Создайте новый лорбук, чтобы хранить миры, правила, места и события." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,14" TextAlignment="Center" HorizontalAlignment="Center" />
                                    <Button Content="Создать лорбук" Command="{Binding AddLorebookCommand}" Style="{StaticResource AccentButton}" Padding="14,8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Lorebooks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300" Height="182" Margin="0,0,16,16" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DataContext.DeleteLorebookCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CircleIconButtonDanger}" Width="26" Height="26" FontSize="11" Padding="0" AutomationProperties.Name="Удалить лорбук" ToolTip="Удалить лорбук" />
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                                        <TextBlock Text="◫" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" Margin="0,12,0,0" />
                                                <DockPanel Grid.Row="2" LastChildFill="False">
                                                    <Border DockPanel.Dock="Left" Style="{StaticResource LibraryMetaChip}" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Entries.Count, StringFormat=Записей: {0}}" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" />
                                                    </Border>
                                                    <Button DockPanel.Dock="Right" Content="Редактор" Command="{Binding DataContext.OpenLibraryLoreEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="10" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryPersonasTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <StackPanel>
                                    <TextBlock Text="Персоны пользователя" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Сохраните разные образы пользователя и назначайте их отдельным персонажам. Персона добавляется в системный контекст до истории чата." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Personas.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="◌" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="Здесь появятся ваши персоны" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="Создайте образ пользователя: имя, роль, характер, биографию и важные постоянные факты." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,14" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="390" HorizontalAlignment="Center" />
                                    <Button Content="Создать персону" Command="{Binding AddPersonaCommand}" Style="{StaticResource AccentButton}" Padding="14,8" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Personas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="236" Height="280" Margin="0,0,16,16">
                                            <Border x:Name="PersonaCard" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                                                <Grid>
                                                    <Border Background="{StaticResource ElevatedBrush}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Bottom" Height="142" Background="{StaticResource LibraryCardScrimGradient}" />
                                                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,15,16">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Foreground="{StaticResource CardScrimTextBrush}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="0,4,0,0" />
                                                        <Border Style="{StaticResource LibraryMetaChip}" Margin="0,7,0,0">
                                                            <TextBlock Text="Персона пользователя" FontSize="10" Foreground="{StaticResource AccentHoverBrush}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <Border x:Name="CardActions" Background="{StaticResource LibraryCardActionsOverlayBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <Button Content="✎" Command="{Binding DataContext.OpenPersonaEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="Редактировать персону" ToolTip="Редактировать персону" />
