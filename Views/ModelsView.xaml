<UserControl x:Class="SoulExe.Views.ModelsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
        <Border Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,12">
            <DockPanel LastChildFill="False"><Border DockPanel.Dock="Right" Style="{StaticResource Chip}" Padding="4" CornerRadius="12"><StackPanel Orientation="Horizontal" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Вкладки моделей"><Button Content="Каталог" Command="{Binding SetModelsHubTabCommand}" CommandParameter="Catalog" AutomationProperties.Name="Каталог" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="3" TabIndex="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}"><Style.Triggers><DataTrigger Binding="{Binding IsModelsCatalogTab}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Рекомендации" Command="{Binding SetModelsHubTabCommand}" CommandParameter="Recommendations" AutomationProperties.Name="Рекомендации" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="3" TabIndex="1"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}"><Style.Triggers><DataTrigger Binding="{Binding IsModelsRecommendationsTab}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Установленные" Command="{Binding SetModelsHubTabCommand}" CommandParameter="Installed" AutomationProperties.Name="Установленные" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="3" TabIndex="2"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}"><Style.Triggers><DataTrigger Binding="{Binding IsModelsInstalledTab}" Value="True"><Setter Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter Property="AutomationProperties.ItemStatus" Value="Выбрана" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></DockPanel>
        </Border>
        <Border Grid.Row="1" Style="{StaticResource SystemStatusCard}" Padding="16" Margin="0,0,0,12"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ТЕКУЩАЯ МОДЕЛЬ И ДВИЖОК" Style="{StaticResource SectionLabel}" Foreground="{StaticResource AccentHoverBrush}" /><TextBlock Text="{Binding ModelState}" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0" /><TextBlock Text="{Binding ModelSourceText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,3,0,0" /><TextBlock Text="{Binding ModelDownloadStatus}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0"><Button Content="{Binding ModelStartStopText}" Command="{Binding ToggleModelStartStopCommand}" Style="{StaticResource AccentButton}" /><Button Content="{Binding ModelDownloadPauseResumeText}" Command="{Binding ToggleModelDownloadCommand}" ToolTip="Поставить загрузку на паузу или продолжить её"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{StaticResource WarningBrush}" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsModelDownloadInProgress}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger><DataTrigger Binding="{Binding CanResumeModelDownload}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Отменить" Command="{Binding CancelModelDownloadCommand}" Margin="0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource DangerButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding CanCancelModelDownload}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Grid><Expander Header="Диагностика запуска" Margin="0,10,0,0"><StackPanel Margin="0,5,0,0"><TextBlock Text="{Binding ModelLaunchDiagnostic}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding ModelLaunchCommand}" Foreground="{StaticResource TextMutedBrush}" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0" /></StackPanel></Expander></StackPanel></Border>
        <Border Grid.Row="2" Padding="18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Surface}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsModelsCatalogTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Каталог GGUF" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="1. Найдите репозиторий. 2. Выберите GGUF-файл. 3. Скачайте его." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /></StackPanel><Button DockPanel.Dock="Right" Content="Найти" Command="{Binding SearchModelsCommand}" Style="{StaticResource CompactButton}" Background="{StaticResource BorderStrongBrush}" /><TextBox Text="{Binding ModelSearchQuery, UpdateSourceTrigger=PropertyChanged}" ToolTip="Поиск GGUF-моделей" /></DockPanel><Grid Grid.Row="1" Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><ListBox ItemsSource="{Binding ModelSearchResults}" SelectedItem="{Binding SelectedModelResult}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardGradientBrush}" CornerRadius="8" Padding="10" Margin="0,3"><StackPanel><TextBlock Text="{Binding RepositoryId}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Border Grid.Column="1" Style="{StaticResource PreviewPanelCard}" Margin="14,0"><StackPanel><TextBlock Text="О ВЫБРАННОМ РЕПОЗИТОРИИ" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding SelectedModelDetails.RepositoryId}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedModelDetails.Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedModelDetails.Downloads, StringFormat=Загрузки: {0:N0}}" Foreground="{StaticResource SuccessTextBrush}" /><TextBlock Text="{Binding SelectedModelDetails.PipelineText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedModelDetails.UpdatedText}" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding SelectedModelDetails.Description}" TextWrapping="Wrap" Margin="0,8,0,0" /></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource PreviewPanelCard}"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions><StackPanel><TextBlock Text="Файлы GGUF" Style="{StaticResource SectionLabel}" /><TextBlock Text="Выберите квант, подходящий вашей памяти, затем начните загрузку." Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" /></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding ModelFiles}" SelectedItem="{Binding SelectedModelFile}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardGradientBrush}" CornerRadius="7" Padding="8" Margin="0,2"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DisplaySize}" Foreground="{StaticResource AccentHoverBrush}" /><TextBlock Text="{Binding Path}" TextTrimming="CharacterEllipsis" /></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><Button Grid.Row="2" Content="Скачать выбранный GGUF" Command="{Binding DownloadSelectedModelCommand}" Style="{StaticResource AccentButton}" Margin="0" /></Grid></Border></Grid></Grid></Border>
        <Grid Grid.Row="2"><Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsModelsRecommendationsTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions><Border Grid.Column="0" Style="{StaticResource Surface}" Padding="18" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Рекомендации" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="1. Выберите модель. 2. Проверьте детали. 3. Скачайте рекомендуемый квант." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /></StackPanel><Button DockPanel.Dock="Right" Content="↻ Обновить" Command="{Binding LoadRecommendedModelsCommand}" Style="{StaticResource CompactButton}" /></DockPanel><ListBox Grid.Row="1" ItemsSource="{Binding RecommendedModels}" SelectedItem="{Binding SelectedRecommendedModel}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardGradientBrush}" CornerRadius="8" Padding="10" Margin="0,3"><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding OptimalQuant}" Foreground="{StaticResource AccentHoverBrush}" /><TextBlock Text="{Binding Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding Downloads, StringFormat=Загрузки: {0:N0}}" Foreground="{StaticResource TextMutedBrush}" /><TextBlock Text="{Binding HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" /></StackPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border><Border Grid.Column="1" Style="{StaticResource Surface}" Padding="18"><ScrollViewer><StackPanel><TextBlock Text="О ВЫБРАННОЙ МОДЕЛИ" Style="{StaticResource SectionLabel}" /><TextBlock Text="{Binding SelectedRecommendedModel.Name}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedRecommendedModel.Author, StringFormat=Автор модели: {0}}" Foreground="{StaticResource TextSecondaryBrush}" /><TextBlock Text="{Binding SelectedRecommendedModel.OptimalQuant}" Foreground="{StaticResource AccentHoverBrush}" /><TextBlock Text="{Binding SelectedRecommendedModel.Downloads, StringFormat=Загрузки: {0:N0}}" Foreground="{StaticResource SuccessTextBrush}" /><TextBlock Text="{Binding SelectedRecommendedModel.Description}" TextWrapping="Wrap" Margin="0,8,0,0" /><TextBlock Text="{Binding SelectedRecommendedModel.AuthorNotes}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedRecommendedModel.HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding RecommendedModelSizeInfo}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" /><TextBlock Text="{Binding SelectedRecommendedModel.InstallationStateText}" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" /><Button Content="{Binding RecommendedModelDownloadText}" Command="{Binding DownloadRecommendedModelCommand}" Style="{StaticResource AccentButton}" Margin="0,14,0,0" /></StackPanel></ScrollViewer></Border></Grid>
        <Border Grid.Row="2" Padding="18"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource Surface}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsModelsInstalledTab}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions><DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Установленные модели" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Выберите GGUF из списка или укажите файл, который уже находится на компьютере." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" /></StackPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Выбрать файл GGUF" Command="{Binding ChooseModelCommand}" Style="{StaticResource GhostButton}" Margin="0,0,8,0" /><Button Content="↻ Обновить" Command="{Binding RefreshInstalledModelsCommand}" Style="{StaticResource CompactButton}" /></StackPanel></DockPanel><Grid Grid.Row="1"><ListBox ItemsSource="{Binding InstalledModels}" SelectedItem="{Binding SelectedInstalledModel}" Background="Transparent" BorderThickness="0"><ListBox.Style><Style TargetType="ListBox"><Style.Triggers><DataTrigger Binding="{Binding HasInstalledModels}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style><ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource CardGradientBrush}" CornerRadius="8" Padding="10" Margin="0,3"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding DisplaySize}" Foreground="{StaticResource AccentHoverBrush}" /><StackPanel><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" /><TextBlock Text="{Binding LocalPath}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" /></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasInstalledModels}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Локальные модели не найдены" FontSize="17" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Укажите уже скачанный GGUF или скачайте модель из каталога. После выбора модель применяется автоматически; запуск доступен в общей карточке выше." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" /><Button Content="Выбрать файл GGUF" Command="{Binding ChooseModelCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Center" Margin="0,14,0,0" /></StackPanel></Grid></Grid></Border>
        <Border Grid.Row="2" Panel.ZIndex="10" BorderBrush="#E85A73" BorderThickness="1" Padding="18">
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Surface}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsModelsCatalogTab}" Value="True" /><Condition Binding="{Binding HasModelsCatalogError}" Value="True" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420"><TextBlock Text="Ошибка поиска каталога" FontWeight="SemiBold" FontSize="16" HorizontalAlignment="Center" /><TextBlock Text="{Binding ModelsCatalogError}" Foreground="{StaticResource TextSecondaryBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,12" /><Button Content="Повторить" Command="{Binding SearchModelsCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center" /></StackPanel>
        </Border>
    </Grid>
</UserControl>
