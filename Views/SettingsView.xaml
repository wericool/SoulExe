                                                <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBrush}" CornerRadius="10" Padding="9,4" VerticalAlignment="Center">
                                                    <TextBlock Text="В реальном времени" Foreground="{StaticResource SuccessTextBrush}" FontSize="10" FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="Предпросмотр чата" FontSize="18" FontWeight="SemiBold" />
                                                    <TextBlock Text="Пузыри, текст, ширина и фон обновляются сразу." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Grid.Row="1" Background="{Binding ChatAppearance.ChatBackgroundColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="14" Margin="0,16,0,16" MinHeight="470" ClipToBounds="True">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>
                                                    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="14,11">
                                                        <DockPanel LastChildFill="False">
                                                            <TextBlock DockPanel.Dock="Right" Text="сейчас" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource AccentGradientBrush}">
                                                                    <TextBlock Text="П" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="Персонаж" FontWeight="SemiBold" FontSize="12" />
                                                                    <TextBlock Text="последнее сообщение только что" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Padding="14,12">
                                                        <StackPanel VerticalAlignment="Bottom">
                                                            <Border Background="{Binding ChatAppearance.AssistantBubbleColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{Binding ChatAppearance.BubbleCornerRadius}" Padding="12,10" MaxWidth="{Binding ChatAppearance.BubbleMaxWidth}" HorizontalAlignment="Left">
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                                        <Border DockPanel.Dock="Left" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0">
                                                                            <TextBlock Text="П" Foreground="{StaticResource AccentHoverBrush}" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                        </Border>
                                                                        <TextBlock Text="Персонаж" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                                        <TextBlock DockPanel.Dock="Right" Text="12:44" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="12,0,0,0" VerticalAlignment="Center" />
                                                                    </DockPanel>
                                                                    <ui:SelectableFormattedChatBox ContentText="{Binding ChatAppearancePreviewText}" Appearance="{Binding ChatAppearance}" Foreground="{Binding ChatAppearance.TextColor}" />
                                                                </StackPanel>
                                                            </Border>
                                                            <Border Background="{Binding ChatAppearance.AssistantBubbleColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="{Binding ChatAppearance.BubbleCornerRadius}" Padding="12,9" MaxWidth="{Binding ChatAppearance.BubbleMaxWidth}" HorizontalAlignment="Left" Margin="0,10,48,0">
                                                                <DockPanel LastChildFill="False">
                                                                    <TextBlock DockPanel.Dock="Right" Text="12:45" Foreground="{StaticResource TextMutedBrush}" FontSize="9" Margin="10,0,0,0" VerticalAlignment="Bottom" />
                                                                    <TextBlock Text="*Она на мгновение задумалась и улыбнулась.*" FontStyle="Italic" FontSize="{Binding ChatAppearance.FontSize}" Foreground="{Binding ChatAppearance.ActionColor}" TextWrapping="Wrap" />
                                                                </DockPanel>
                                                            </Border>
                                                            <Border Background="{Binding ChatAppearance.UserBubbleColor}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="{Binding ChatAppearance.BubbleCornerRadius}" Padding="12,10" MaxWidth="{Binding ChatAppearance.BubbleMaxWidth}" HorizontalAlignment="Right" Margin="48,12,0,0">
                                                                <StackPanel>
                                                                    <DockPanel LastChildFill="False" Margin="0,0,0,6">
                                                                        <TextBlock Text="Вы" FontWeight="SemiBold" FontSize="11" Foreground="White" />
                                                                        <TextBlock DockPanel.Dock="Right" Text="12:46" Foreground="{StaticResource ChatOutboundMetaBrush}" FontSize="9" Margin="12,0,0,0" />
                                                                    </DockPanel>
                                                                    <TextBlock Text="Понятно. Я хочу продолжить разговор и узнать больше." FontSize="{Binding ChatAppearance.FontSize}" Foreground="White" TextWrapping="Wrap" />
                                                                </StackPanel>
                                                            </Border>
                                                        </StackPanel>
                                                    </ScrollViewer>
                                                    <Border Grid.Row="2" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1,1,0,0" Padding="12,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="32" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="Сообщение..." Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                                            <Border Grid.Column="1" Width="28" Height="28" CornerRadius="9" Background="{StaticResource AccentGradientBrush}" HorizontalAlignment="Right">
                                                                <TextBlock Text="➤" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <DockPanel Grid.Row="2" LastChildFill="False">
                                                <Button DockPanel.Dock="Right" Content="Сохранить оформление" Command="{Binding SaveChatAppearanceCommand}" Style="{StaticResource AccentButton}" />
                                                <Button Content="↻  Сбросить" Command="{Binding ResetChatAppearanceCommand}" Style="{StaticResource GhostButton}" />
                                            </DockPanel>
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsMobileOptionsTab}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <views:MobileAccessView />
                                </Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModelsOptionsTab}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
<views:ModelsView />
                                </Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSetupOptionsTab}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <views:SetupView />
                                </Grid>
                            </Grid>
                        </Grid>
</UserControl>
