<UserControl x:Class="SoulExe.Views.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SoulExe" xmlns:views="clr-namespace:SoulExe.Views">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource ElevatedBrush}" HorizontalAlignment="Left" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="5" Margin="0,0,0,14">
                                    <WrapPanel KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="{DynamicResource S.Settings.Tabs}">
                                        <Button Content="{DynamicResource S.Tab.Setup}" Command="{Binding SelectOptionsTabCommand}" CommandParameter="setup" Padding="16,9" Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource S.Tab.Setup}" AutomationProperties.PositionInSet="1" AutomationProperties.SizeOfSet="5" TabIndex="0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSetupOptionsTab}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Settings.Selected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource S.Tab.Runtime}" Command="{Binding SelectOptionsTabCommand}" CommandParameter="llm" Padding="16,9" Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource S.Tab.Runtime}" AutomationProperties.PositionInSet="2" AutomationProperties.SizeOfSet="5" TabIndex="1">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsLlmOptionsTab}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Settings.Selected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource S.Tab.Models}" Command="{Binding SelectOptionsTabCommand}" CommandParameter="models" Padding="16,9" Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource S.Tab.Models}" AutomationProperties.PositionInSet="3" AutomationProperties.SizeOfSet="5" TabIndex="2">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsModelsOptionsTab}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Settings.Selected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource S.Tab.Appearance}" Command="{Binding SelectOptionsTabCommand}" CommandParameter="appearance" Padding="16,9" Margin="0,0,4,0" AutomationProperties.Name="{DynamicResource S.Tab.Appearance}" AutomationProperties.PositionInSet="4" AutomationProperties.SizeOfSet="5" TabIndex="3">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAppearanceOptionsTab}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Settings.Selected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{DynamicResource S.Tab.Mobile}" Command="{Binding SelectOptionsTabCommand}" CommandParameter="mobile" Padding="16,9" AutomationProperties.Name="{DynamicResource S.Tab.Mobile}" AutomationProperties.PositionInSet="5" AutomationProperties.SizeOfSet="5" TabIndex="4">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PseudoTabButton}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMobileOptionsTab}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                            <Setter Property="Foreground" Value="White" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                            <Setter Property="FontWeight" Value="SemiBold" />
                                                            <Setter Property="AutomationProperties.ItemStatus" Value="{DynamicResource S.Settings.Selected}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </WrapPanel>
                            </Border>
                            <Grid Grid.Row="1">
                                <Grid Margin="0,0,0,0">
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Visible" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLlmOptionsTab}" Value="False">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                        <StackPanel>
                                            <TextBlock Text="{DynamicResource S.Settings.PageHeader}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{DynamicResource S.Settings.PageSubheader}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,18" />
                                            <!-- Cognitive Architecture is configured inside each character card. -->
                                            <!-- Основная генерация. -->
                                            <Border Style="{StaticResource SheetSectionElevated}" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.Section1.Title}" FontSize="17" FontWeight="SemiBold" />
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.Response}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.MaxTokens}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.MaxTokens.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="128" Maximum="65536" Ticks="128,256,512,768,1024,1536,2048,3072,4096,8192,16384,32768,65536" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutoToolTipPlacement="BottomRight" Value="{Binding LlamaOptions.MaxTokens}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.MaxTokens}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal" IsEnabled="{Binding LlamaOptions.ReasoningMode}">
                                                            <TextBlock Text="{DynamicResource S.Settings.ReasoningBudget}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.ReasoningBudget.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="-1" Maximum="8192" SmallChange="64" Value="{Binding LlamaOptions.ReasoningBudget}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.ReasoningBudget}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.Temperature}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Temperature" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.Temperature.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding LlamaOptions.Temperature}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.Temperature}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Top-P" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.TopP.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding LlamaOptions.TopP}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.TopP}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.Repetition}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.FrequencyPenalty}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.FrequencyPenalty.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding LlamaOptions.FrequencyPenalty}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.FrequencyPenalty}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.PresencePenalty}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.PresencePenalty.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding LlamaOptions.PresencePenalty}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.PresencePenalty}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <!-- Оборудование. -->
                                            <Border Style="{StaticResource SheetSectionElevated}" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.Section2.Title}" FontSize="17" FontWeight="SemiBold" />
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.Engine}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.ServerLaunchCommand}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.ServerLaunchCommand.HelpHint}" />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Text="{Binding ModelLaunchCommand, Mode=OneWay}" IsReadOnly="True" ToolTip="{DynamicResource S.Settings.ServerLaunchCommand.ToolTip}" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.ComputeBackend}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.ComputeBackend.HelpHint}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding LlamaBackends}" SelectedItem="{Binding SelectedLlamaBackend}" DisplayMemberPath="DisplayName" />
                                                        <Button Grid.Column="2" Content="{DynamicResource S.Settings.Install}" Command="{Binding InstallEngineCommand}" Background="{StaticResource BorderStrongBrush}" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.KVCacheType}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.KVCacheType.HelpHint}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding LlamaOptions.KvCacheType}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="f16" />
                                                            <ComboBoxItem Content="q8_0" />
                                                            <ComboBoxItem Content="q4_1" />
                                                            <ComboBoxItem Content="q4_0" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <WrapPanel Margin="170,10,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                            <CheckBox Content="MLock" IsChecked="{Binding LlamaOptions.UseMlock}" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.MLock.HelpHint}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                            <CheckBox Content="{DynamicResource S.Settings.MMAP}" IsChecked="{Binding LlamaOptions.UseMmap}" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.MMAP.HelpHint}" />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox Content="Flash Attention" IsChecked="{Binding LlamaOptions.FlashAttention}" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.FlashAttention.HelpHint}" />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="225" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox Content="{DynamicResource S.Settings.ReasoningMode}" IsChecked="{Binding LlamaOptions.ReasoningMode}" FontWeight="SemiBold" />
                                                                <ui:HelpHint Hint="{DynamicResource S.Settings.ReasoningMode.HelpHint}" />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" IsEnabled="{Binding LlamaOptions.ReasoningMode}">
                                                                <TextBlock Text="{DynamicResource S.Settings.ReasoningMode.Hint}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DockPanel Margin="0,20,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.Performance}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.GPULayers}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.GPULayers.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LlamaOptions.GpuLayers}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.GpuLayers}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.MoELayersOnCPU}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.MoELayersOnCPU.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LlamaOptions.CpuMoeLayers}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.CpuMoeLayers}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.ContextSize}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.ContextSize.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="2048" Maximum="131072" Ticks="2048,4096,8192,16384,32768,65536,131072" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutoToolTipPlacement="BottomRight" Value="{Binding LlamaOptions.ContextSize}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.ContextSize}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.PromptBatchSize}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.PromptBatchSize.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="8192" LargeChange="128" Value="{Binding LlamaOptions.BatchSize}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.BatchSize}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.CPUThreads}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.CPUThreads.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="64" Value="{Binding LlamaOptions.CpuThreads}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.CpuThreads}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,4">
                                                        <TextBlock Text="{DynamicResource S.Settings.CustomLlamaCppArgs}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                        <ui:HelpHint Hint="{DynamicResource S.Settings.CustomLlamaCppArgs.HelpHint}" />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding LlamaOptions.ExtraArguments}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Prompt и расширенный sampling. -->
                                            <Border Style="{StaticResource SheetSectionElevated}" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="{DynamicResource S.Settings.Section3.Title}" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="{DynamicResource S.Settings.TemplateAndStopStrings}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border Background="{StaticResource BorderStrongBrush}" Height="1" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.ChatTemplate}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.ChatTemplate.HelpHint}" />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding LlamaOptions.ChatTemplate}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="auto" />
                                                            <ComboBoxItem Content="chatml" />
                                                            <ComboBoxItem Content="llama-3" />
                                                            <ComboBoxItem Content="deepseek" />
                                                            <ComboBoxItem Content="qwen" />
                                                            <ComboBoxItem Content="mistral" />
                                                            <ComboBoxItem Content="alpaca" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{DynamicResource S.Settings.StopStrings}" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.StopStrings.HelpHint}" />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Text="{Binding LlamaOptions.StopStrings}" ToolTip="{DynamicResource S.Settings.StopStrings.ToolTip}" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Style="{StaticResource SheetSectionElevated}" Padding="18">
                                                <Expander IsExpanded="False">
                                                    <Expander.Header>
                                                        <StackPanel>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox Content="{DynamicResource S.Settings.Section4.Title}" IsChecked="{Binding LlamaOptions.EnableAdvancedSampling}" FontSize="17" FontWeight="SemiBold" />
                                                                <ui:HelpHint Hint="{DynamicResource S.Settings.Section4.HelpHint}" />
                                                            </StackPanel>
                                                            <TextBlock Text="Необязательные настройки для опытной настройки генерации. По умолчанию их можно не менять." Style="{StaticResource InlineHelp}" Margin="0,5,0,0" MaxWidth="620" />
                                                        </StackPanel>
                                                    </Expander.Header>
                                                    <Grid IsEnabled="{Binding LlamaOptions.EnableAdvancedSampling}" Margin="0,17,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Min-P" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="{DynamicResource S.Settings.MinP.HelpHint}" />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding LlamaOptions.MinP}" />
