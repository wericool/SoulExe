<UserControl x:Class="SoulExe.Views.ChatWorkspaceView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:SoulExe" xmlns:controls="clr-namespace:SoulExe.Controls" PreviewKeyDown="ChatWorkspaceView_OnPreviewKeyDown" Loaded="ChatWorkspaceView_OnLoaded" SizeChanged="ChatWorkspaceView_OnSizeChanged">
    <UserControl.Resources>
        <!-- Local-only styles. Never register implicit templates for layout controls here. -->
        <Style x:Key="StageSideGlass" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
        </Style>
    </UserControl.Resources>
    <Grid x:Name="LayoutRoot" Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="ListColumn" Width="300" MinWidth="248" />
            <ColumnDefinition x:Name="ListSplitterColumn" Width="14" />
            <ColumnDefinition x:Name="ThreadColumn" Width="*" MinWidth="430" />
            <ColumnDefinition x:Name="DetailsSplitterColumn" Width="14" />
            <ColumnDefinition x:Name="DetailsColumn" Width="300" MinWidth="248" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Margin="12,64,0,12" Style="{StaticResource StageSideGlass}">
            <ContentControl x:Name="WideListHost">
                <controls:ConversationListView x:Name="ConversationList" />
            </ContentControl>
        </Border>
        <GridSplitter x:Name="ListSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ToolTip="Изменить ширину списка диалогов" />

        <ContentControl Grid.Column="2" x:Name="ThreadHost" Focusable="False" Margin="0,64,0,12">
            <controls:ConversationThreadView x:Name="ConversationThread" />
        </ContentControl>

        <GridSplitter x:Name="DetailsSplitter" Grid.Column="3" Width="6" HorizontalAlignment="Center" Background="Transparent"
                      ResizeDirection="Columns" ResizeBehavior="PreviousAndNext"
                      ToolTip="Изменить ширину панели информации" />
        <Border Grid.Column="4" Margin="0,64,12,12" Style="{StaticResource StageSideGlass}">
            <ContentControl x:Name="WideDetailsHost">
                <controls:ConversationDetailsPanel x:Name="ConversationDetails" />
            </ContentControl>
        </Border>

        <Border x:Name="DrawerScrim" Grid.ColumnSpan="5" Panel.ZIndex="10" Background="{StaticResource OverlayDrawerBrush}" Visibility="Collapsed" MouseLeftButtonDown="DrawerScrim_OnMouseLeftButtonDown" />
        <Border x:Name="ListDrawer" Grid.ColumnSpan="5" Panel.ZIndex="11" HorizontalAlignment="Left" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="0,20,20,0" Visibility="Collapsed">
            <ContentControl x:Name="ListDrawerHost" />
        </Border>
        <Border x:Name="DetailsDrawer" Grid.ColumnSpan="5" Panel.ZIndex="11" HorizontalAlignment="Right" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20,0,0,20" Visibility="Collapsed">
            <ContentControl x:Name="DetailsDrawerHost" />
        </Border>
        <Border Grid.ColumnSpan="5" Panel.ZIndex="30" Background="{StaticResource OverlayModalBrush}" CornerRadius="16">
            <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsNewChatCharacterPickerOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
            <Border x:Name="NewChatDialog" Width="570" MaxHeight="760" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource AccentGlowEffect}" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
                    <TextBlock Text="Новый разговор" FontSize="20" FontWeight="SemiBold" />
                    <TextBlock Text="Выберите личный разговор с персонажем или групповой разговор двух персонажей." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,7,0,16" />
                    <TextBlock Text="Тип разговора" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" />
                    <ComboBox x:Name="NewChatInitialFocus" SelectedValue="{Binding NewConversationType}" SelectedValuePath="Tag" MinHeight="42" Margin="0,0,0,14"><ComboBoxItem Content="Личный разговор" Tag="chat" /><ComboBoxItem Content="Групповой разговор" Tag="scene" /></ComboBox>
                    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsNewSceneType}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBlock Text="Персонаж" Style="{StaticResource SectionLabel}" Margin="0,0,0,6" /><ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding NewChatCharacter}" DisplayMemberPath="Name" MinHeight="42" /><TextBlock Text="Название чата" Style="{StaticResource SectionLabel}" Margin="0,14,0,6" /><TextBox Text="{Binding NewChatNameDraft, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" Padding="12,8" ToolTip="Например: Учёба, Путешествие, Новая история" /></StackPanel>
                    <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsNewSceneType}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Участники группового разговора" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Персонаж A" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SceneCharacterA}" DisplayMemberPath="Name" MinHeight="42" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Персонаж B" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" /><ComboBox ItemsSource="{Binding Characters}" SelectedItem="{Binding SceneCharacterB}" DisplayMemberPath="Name" MinHeight="42" /></StackPanel></Grid>
                        <TextBlock Text="Название разговора" Style="{StaticResource SectionLabel}" Margin="0,14,0,5" /><TextBox Text="{Binding SceneNameDraft, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" Padding="12,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,5"><TextBlock Text="Сценарий" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Опишите стартовую ситуацию, важные правила и то, что происходит между участниками." /></StackPanel><TextBox Text="{Binding SceneScenarioDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="68" />
                        <Grid Margin="0,14,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Место" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Например: фойе кинотеатра, кафе, улица или кабинет." /></StackPanel><TextBox Text="{Binding SceneLocationDraft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Время" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Например: вечер, утро, осень, перед началом фильма." /></StackPanel><TextBox Text="{Binding SceneTimeDraft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
                        <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions><StackPanel><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Настроение" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Задаёт общий эмоциональный тон сцены." /></StackPanel><TextBox Text="{Binding SceneMoodDraft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel><StackPanel Grid.Column="2"><StackPanel Orientation="Horizontal" Margin="0,0,0,5"><TextBlock Text="Цель" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Желаемый естественный итог сцены; помогает развивать диалог, а не повторяться." /></StackPanel><TextBox Text="{Binding SceneGoalDraft, UpdateSourceTrigger=PropertyChanged}" /></StackPanel></Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,5"><TextBlock Text="Общие отношения / контекст" Style="{StaticResource SectionLabel}" /><ui:HelpHint Hint="Например: друзья, коллеги, одноклассники, незнакомцы." /></StackPanel><TextBox Text="{Binding SceneRelationshipDraft, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="44" />
                        <StackPanel Margin="0,12,0,0"><TextBlock Text="Пауза между репликами, сек" Style="{StaticResource SectionLabel}" Margin="0,0,0,5" /><TextBox Text="{Binding SceneDelaySecondsDraft, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" /></StackPanel>
                        <CheckBox Content="Соблюдать рамки сцены" IsChecked="{Binding SceneEnforceContractDraft}" Margin="0,14,0,0" /><CheckBox Content="Развивать сцену и избегать повторов" IsChecked="{Binding SceneAdvanceNarrativeDraft}" Margin="0,8,0,0" ToolTip="Добавляет при каждой реплике правило: не повторять недавний диалог, вносить новый смысловой шаг и естественно двигать текущую цель сцены." /><TextBlock Text="Каждая реплика будет добавлять новую мысль, реакцию, действие или вопрос вместо пересказа уже сказанного." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="24,4,0,0" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Отмена" Command="{Binding CancelNewChatCharacterPickerCommand}" Style="{StaticResource GhostButton}" /><Button Content="{Binding NewConversationConfirmText}" Command="{Binding ConfirmNewChatForCharacterCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" /></StackPanel>
                </StackPanel></ScrollViewer>
            </Border>
        </Border>
        <Border Grid.ColumnSpan="5" Panel.ZIndex="31" Background="{StaticResource OverlayModalBrush}" CornerRadius="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRenameChatDialogOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Border x:Name="RenameChatDialog" Width="420" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource AccentGlowEffect}" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"><StackPanel><TextBlock Text="Переименовать чат" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="{Binding RenameChatItem.CharacterName}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16" /><TextBlock Text="Новое название" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" /><TextBox x:Name="RenameChatInitialFocus" Text="{Binding RenameChatNameDraft, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" Padding="12,8" ToolTip="Введите новое название диалога" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Отмена" Command="{Binding CancelRenameChatDialogCommand}" Style="{StaticResource GhostButton}" /><Button Content="Сохранить" Command="{Binding ConfirmRenameChatCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" /></StackPanel></StackPanel></Border></Border>
        <Border Grid.ColumnSpan="5" Panel.ZIndex="32" Background="{StaticResource OverlayModalBrush}" CornerRadius="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsRenameSceneDialogOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><Border x:Name="RenameSceneDialog" Width="420" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource AccentGlowEffect}" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"><StackPanel><TextBlock Text="Переименовать сцену" FontSize="20" FontWeight="SemiBold" /><TextBlock Text="Введите новое название диалога двух персонажей." Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,16" /><TextBlock Text="Новое название" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,6" /><TextBox x:Name="RenameSceneInitialFocus" Text="{Binding RenameSceneNameDraft, UpdateSourceTrigger=PropertyChanged}" MinHeight="42" Padding="12,8" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0"><Button Content="Отмена" Command="{Binding CancelRenameSceneCommand}" Style="{StaticResource GhostButton}" /><Button Content="Сохранить" Command="{Binding ConfirmRenameSceneCommand}" Style="{StaticResource AccentButton}" Margin="8,0,0,0" /></StackPanel></StackPanel></Border></Border>
        <Border Grid.ColumnSpan="5" Panel.ZIndex="40" Background="{StaticResource OverlayModalBrush}" CornerRadius="16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsPendingDeletionDialogOpen}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><Border x:Name="PendingDeletionDialog" Width="470" Background="{StaticResource PanelBrush}" BorderBrush="#E85A73" BorderThickness="1" CornerRadius="16" Padding="24" HorizontalAlignment="Center" VerticalAlignment="Center" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle"><StackPanel><TextBlock Text="{Binding PendingDeletion.Title}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding PendingDeletion.Description}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/><Border Background="#27151C" BorderBrush="#5A2736" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,16,0,0"><TextBlock Text="{Binding PendingDeletion.Warning}" Foreground="#F7BEC9" TextWrapping="Wrap"/></Border><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0"><Button x:Name="PendingDeletionInitialFocus" Content="Отмена" Command="{Binding CancelPendingDeletionCommand}" Style="{StaticResource GhostButton}"/><Button Content="Удалить навсегда" Command="{Binding ConfirmPendingDeletionCommand}" Style="{StaticResource DangerButton}" Padding="16,9" Margin="8,0,0,0"/></StackPanel></StackPanel></Border></Border>
    </Grid>
</UserControl>
