<UserControl x:Class="SoulExe.Views.GatewayView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Border Style="{StaticResource Surface}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <DockPanel LastChildFill="False" Margin="0,0,0,14">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="NSFW" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0">
                            <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowGatewayNsfw}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <ToggleButton IsChecked="{Binding GatewayNsfwEnabled}" Width="44" Height="24" VerticalAlignment="Center" ToolTip="Показывать NSFW только в Chub AI" Focusable="True" AutomationProperties.Name="Показывать материалы NSFW" AutomationProperties.HelpText="Показывает NSFW-материалы только в каталоге Chub AI.">
                            <ToggleButton.Style><Style TargetType="ToggleButton"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowGatewayNsfw}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></ToggleButton.Style>
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Track" Background="{StaticResource BorderStrongBrush}" CornerRadius="12" Padding="3"><Ellipse x:Name="Thumb" Width="16" Height="16" Fill="{StaticResource TextPrimaryBrush}" HorizontalAlignment="Left" /></Border>
                                    <ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBrush}" /><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" /></Trigger></ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Каталог материалов" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Text="Soul Gateway · Chub AI · лорбуки и сценарии" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
                <ListBox ItemsSource="{Binding GatewayCategories}" SelectedValue="{Binding GatewayCategory}" SelectedValuePath="Id" Background="Transparent" BorderThickness="0" Margin="0,0,0,12" ScrollViewer.HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Категории каталога материалов">
                    <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="Margin" Value="0,0,8,0" /><Setter Property="Padding" Value="0" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Tab" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="14,8"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" /></Border>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="Tab" Property="Background" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="Tab" Property="BorderBrush" Value="{StaticResource AccentBrush}" /></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBox Text="{Binding GatewayQuery, UpdateSourceTrigger=PropertyChanged}" Padding="12,10" ToolTip="Поиск в выбранной вкладке" />
                    <Button Grid.Column="2" Content="⌕  Найти" Command="{Binding SearchGatewayCommand}" Style="{StaticResource AccentButton}" Padding="16,10" />
                </Grid>
            </StackPanel>
        </Border>
        <Grid x:Name="GatewayContentGrid" Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="330" /></Grid.ColumnDefinitions>
            <Border x:Name="GatewayCatalogPanel" Grid.Column="0" Style="{StaticResource Surface}" Background="{StaticResource WindowBrush}" Padding="14" Margin="0,0,12,0">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <StackPanel><TextBlock Text="{Binding GatewayCategoryTitle}" FontSize="22" FontWeight="SemiBold" /><TextBlock Text="{Binding GatewayCategorySubtitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" /></StackPanel>
                    <Border Grid.Row="1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,14,0,0" Padding="18">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Загрузка материалов" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Получаем каталог выбранной категории..." Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Row="1" Background="{StaticResource ElevatedBrush}" BorderBrush="#E85A73" BorderThickness="1" CornerRadius="10" Margin="0,14,0,0" Padding="18"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasGatewayError}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="Ошибка загрузки каталога" FontWeight="SemiBold" HorizontalAlignment="Center"/><TextBlock Text="{Binding GatewayError}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,10"/><Button Content="Повторить" Command="{Binding SearchGatewayCommand}" Style="{StaticResource GhostButton}" HorizontalAlignment="Center"/></StackPanel></Border>
                    <Border Grid.Row="1" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Margin="0,14,0,0" Padding="18">
                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding IsBusy}" Value="False" /><Condition Binding="{Binding HasGatewayError}" Value="False" /><Condition Binding="{Binding GatewayItems.Count}" Value="0" /></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible" /></MultiDataTrigger></Style.Triggers></Style></Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"><TextBlock Text="Материалы не найдены" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Измените запрос или выберите другую категорию, затем повторите поиск." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,5,0,0" /></StackPanel>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding GatewayItems}" SelectedItem="{Binding SelectedGatewayAsset}" Margin="0,14,0,0" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Style><Style TargetType="ListBox"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsBusy}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger><DataTrigger Binding="{Binding GatewayItems.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></ListBox.Style>
                        <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal" /></ItemsPanelTemplate></ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="GatewayCard" Width="174" Height="238" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="5" ClipToBounds="True">
                                    <Grid>
                                        <Border Background="{StaticResource CardGradientBrush}"><TextBlock Text="?" FontSize="36" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                        <Image Source="{Binding AvatarUrl}" Stretch="UniformToFill" Opacity="0.88" />
                                        <Border VerticalAlignment="Bottom" Height="110"><Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#0010121A" Offset="0" /><GradientStop Color="{StaticResource CharacterHeroScrimColor}" Offset="1" /></LinearGradientBrush></Border.Background></Border>
                                        <StackPanel VerticalAlignment="Bottom" Margin="12,0,12,12"><TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource AccentHoverBrush}" FontSize="9" FontWeight="Bold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="40" Margin="0,4,0,0" /><TextBlock Text="{Binding MetaLine}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,5,0,0" /></StackPanel>
                                    </Grid>
                                </Border>
                                <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter TargetName="GatewayCard" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="GatewayCard" Property="BorderThickness" Value="2" /></DataTrigger></DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <DockPanel Grid.Row="2" Margin="2,10,2,0"><TextBlock Text="{Binding GatewayItems.Count, StringFormat=Материалов: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" /><Button DockPanel.Dock="Right" Content="Загрузить ещё" Command="{Binding LoadMoreGatewayCommand}" Background="{StaticResource CardHoverBrush}"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding GatewayHasMore}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button></DockPanel>
                </Grid>
            </Border>
            <Border x:Name="GatewayDetailsPanel" Grid.Column="1" Style="{StaticResource Surface}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGatewayAsset}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                        <TextBlock Text="Выбранный материал" Foreground="{StaticResource TextMutedBrush}" Style="{StaticResource SectionLabel}" />
                        <Border Height="155" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Margin="0,12,0,0" ClipToBounds="True"><Grid><TextBlock Text="Нет изображения" FontSize="13" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /><Image Source="{Binding SelectedGatewayAsset.AvatarUrl}" Stretch="UniformToFill" /></Grid></Border>
                        <TextBlock Text="{Binding SelectedGatewayAsset.Name}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,13,0,0" /><TextBlock Text="{Binding SelectedGatewayAsset.TypeLabel}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" Margin="0,5,0,0" /><TextBlock Text="{Binding SelectedGatewayAsset.Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" /><TextBlock Text="{Binding SelectedGatewayAsset.Description}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,13,0,0" /><TextBlock Text="{Binding SelectedGatewayAsset.MetaLine}" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0" />
                        <TextBlock Text="{Binding SelectedGatewayAsset.Location, StringFormat=Стартовая локация: {0}}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGatewayAsset.Location}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <Separator Margin="0,18,0,12" Background="{StaticResource BorderBrush}" /><Button Content="{Binding SelectedGatewayAsset.ImportLabel}" Command="{Binding ImportGatewayAssetCommand}" FontWeight="SemiBold"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource SuccessButton}"><Style.Triggers><DataTrigger Binding="{Binding SelectedGatewayAsset.IsAlreadyImported}" Value="True"><Setter Property="Background" Value="{StaticResource CardHoverBrush}" /><Setter Property="IsEnabled" Value="False" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
                        <TextBlock Text="Этот лорбук уже есть в вашей библиотеке." Foreground="{StaticResource SuccessTextBrush}" FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGatewayAsset.IsAlreadyImported}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                        <TextBlock Text="Персонажи сохраняются в библиотеку. Лорбуки доступны в карточке выбранного персонажа. Сценарии создают обычный текстовый чат, без возвращения Soul Stage." Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="10" Margin="2,10,2,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
            <Border x:Name="GatewayEmptyDetailsPanel" Grid.Column="1">
                <Border.Style><Style TargetType="Border" BasedOn="{StaticResource Surface}"><Setter Property="Padding" Value="18" /><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedGatewayAsset}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="250"><TextBlock Text="Материал не выбран" FontWeight="SemiBold" TextAlignment="Center" /><TextBlock Text="Выберите карточку в каталоге, чтобы просмотреть описание и импортировать материал." Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0" /></StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
