<UserControl x:Class="SoulExe.Views.StageShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:views="clr-namespace:SoulExe.Views"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
              PreviewKeyDown="StageShellView_OnPreviewKeyDown"
              KeyDown="StageShellView_OnKeyDown"
             Loaded="StageShellView_OnLoaded"
             Unloaded="StageShellView_OnUnloaded">
    <UserControl.Resources>
        <!-- Local-only styles. Never register implicit templates for layout controls here. -->
        <ui:AvatarBackgroundFallbackOpacityConverter x:Key="AvatarBackgroundFallbackOpacityConverter" />
        <Style x:Key="StageGlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="StageTopIconButton" TargetType="Button" BasedOn="{StaticResource CircleIconButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style x:Key="StageModelChipButton" TargetType="Button" BasedOn="{StaticResource CompactButton}">
            <Setter Property="Height" Value="42" />
            <Setter Property="MinHeight" Value="42" />
            <Setter Property="Background" Value="{StaticResource IconButtonSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="13,0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="236" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="5" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackstageIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,24,0,8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <!-- System buttons match the circular controls on the left side of the stage. -->
        <Style x:Key="StageWindowButton" TargetType="Button" BasedOn="{StaticResource StageTopIconButton}">
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="StageWindowCloseButton" TargetType="Button" BasedOn="{StaticResource StageTopIconButton}">
            <Setter Property="FontSize" Value="14" />
        </Style>
        <!-- Conversation card in the "Continue" rail: glass surface over the scrimmed stage. -->
        <Style x:Key="BackstageConversationCard" TargetType="Button">
            <Setter Property="Width" Value="272" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Character chip in the "Characters" gallery. -->
        <Style x:Key="BackstageCharacterChip" TargetType="Button">
            <Setter Property="Width" Value="118" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="16" Padding="8,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource GlassPanelBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Layer 0: ambient character art, blurred and scrimmed so any message stays readable. -->
        <Grid ClipToBounds="True">
            <Border x:Name="FallbackStageBackground" Background="{Binding ChatAppearance.ChatBackgroundColor}">
                <Border.Opacity>
                    <MultiBinding Converter="{StaticResource AvatarBackgroundFallbackOpacityConverter}">
                        <Binding Path="ChatAppearance.UseCharacterAvatarBackground" />
                        <Binding Path="IsSceneChatActive" />
                        <Binding Path="SelectedCharacter.AvatarPath" />
                        <Binding Path="SelectedSceneCharacterA.AvatarPath" />
                    </MultiBinding>
                </Border.Opacity>
            </Border>
            <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{Binding SelectedCharacter.AvatarPath}" />
                        <Setter Property="Visibility" Value="Visible" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ChatAppearance.UseCharacterAvatarBackground}" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                <Setter Property="Source" Value="{Binding SelectedSceneCharacterA.AvatarPath}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
                <Image.Effect>
                    <BlurEffect Radius="70" />
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                </Image.RenderTransform>
            </Image>
            <Border Background="{StaticResource StageScrimBrush}" />
        </Grid>

        <!-- Layer 1: the stage itself (active conversation). -->
        <ContentControl x:Name="StageHost" />

        <!-- Layer 2: full-page sheets for non-stage routes: a framed panel floating
             over a fading scrim. Motion mirrors the chat drawers (slide+fade). -->
        <Grid x:Name="PageScrim" Visibility="Collapsed" Background="{StaticResource OverlayBrush}" MouseLeftButtonDown="ChromeArea_OnMouseLeftButtonDown" />
        <Grid x:Name="PageSheet" Visibility="Collapsed" Margin="32,82,32,42">
            <Border x:Name="PageSheetFrame" Background="{StaticResource WindowBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20" Effect="{StaticResource CardShadowEffect}">
                <Grid>
                    <ContentControl x:Name="PageHost" Margin="20,14,68,16" />
                    <Button Command="{Binding NavigateCommand}" CommandParameter="Chat" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,14,0" Style="{StaticResource CircleIconButton}" Content="×" FontSize="18" AutomationProperties.Name="{DynamicResource S.Window.Close}" ToolTip="{DynamicResource S.Window.Close}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Layer 3: floating top bar. Transparent background makes its empty band the
             window drag area (CaptionHeight is 1, so nothing native steals clicks). -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="20,14,140,0" Background="Transparent" MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="BackstageButton_OnClick" Style="{StaticResource StageTopIconButton}" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Stage.Menu}" ToolTip="{DynamicResource S.Stage.Menu}" />

            <!-- Presence pill: personal and scene variants. -->
            <Border Grid.Column="2" Style="{StaticResource StageGlassPanel}" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="56" MaxWidth="520" Cursor="Hand" MouseLeftButtonDown="Presence_OnMouseLeftButtonDown" AutomationProperties.Name="{Binding SelectedCharacter.Name, FallbackValue=''}" Visibility="Collapsed">
                <Grid>
                    <!-- Personal presence -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="{Binding SelectedCharacter.Initials}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="11,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCharacter.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            <TextBlock Text="{Binding ModelState}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource S.Stage.Presence.Typing}" FontStyle="Italic" FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <!-- Scene presence -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="58" Height="40">
                            <Ellipse Width="34" Height="34" HorizontalAlignment="Left" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                            <TextBlock Text="{Binding SelectedSceneCharacterA.Initials}" Width="34" HorizontalAlignment="Left" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" />
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                            <TextBlock Text="{Binding SelectedSceneCharacterB.Initials}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Center" Padding="0,6,0,0" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Grid>
                        <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SceneHeaderTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <TextBlock Text="{Binding SceneParticipantNames}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="340">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSceneTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource S.Stage.Presence.Typing}" FontStyle="Italic" FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSceneTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right cluster: settings gear + model chip with its flyout menu. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                <Button Command="{Binding NavigateCommand}" CommandParameter="Options" Style="{StaticResource StageTopIconButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Nav.Options}" ToolTip="{DynamicResource S.Nav.Options}" />
                <Button x:Name="ModelChip" Click="ModelChip_OnClick" Margin="10,0,0,0" Style="{StaticResource StageModelChipButton}" AutomationProperties.Name="{DynamicResource S.Stage.Model}" ToolTip="{Binding ModelState}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding ModelState}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="ModelChipPopup" PlacementTarget="{Binding ElementName=ModelChip}" Placement="Top" VerticalOffset="12" StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource StageGlassPanel}" Width="320" Padding="16" Background="#EE141826">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Stage.Model}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ModelState}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModelDownloadStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <TextBlock Text="ВЫБОР УСТАНОВЛЕННОЙ МОДЕЛИ" Style="{StaticResource SectionLabel}" Margin="0,14,0,5" />
                            <ComboBox ItemsSource="{Binding InstalledModels}" SelectedItem="{Binding SelectedInstalledModel}" ToolTip="Выберите модель для запуска">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding DisplaySize}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Content="{Binding ModelStartStopText}" Command="{Binding ToggleModelStartStopCommand}" Style="{StaticResource AccentButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                            <Button Content="{Binding ModelDownloadPauseResumeText}" Command="{Binding ToggleModelDownloadCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelDownloadInProgress}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanResumeModelDownload}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Separator Margin="0,14,0,6" Background="{StaticResource BorderBrush}" />
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Models" Click="ModelChipNav_OnClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Tab.Models}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Options" Click="ModelChipNav_OnClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Options}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- Layer 4: Backstage overlay-hub. Sections: Continue rail, Characters gallery, system cards. -->
        <Grid x:Name="BackstageOverlay" Visibility="Collapsed" Background="{StaticResource WindowBrush}" KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="ChromeArea_OnMouseLeftButtonDown">
            <Button x:Name="BackstageCloseButton" Click="BackstageNav_OnClick" Content="×" FontSize="18" Style="{StaticResource CircleIconButton}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,70,24,0" Panel.ZIndex="1" AutomationProperties.Name="{DynamicResource S.Window.Close}" ToolTip="{DynamicResource S.Window.Close}" />
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="980" Margin="32,54,32,40" HorizontalAlignment="Center">
                    <TextBlock Text="SoulExe" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Backstage.Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,4" />

                    <!-- Персонажи: horizontal gallery with a visible add-card at the end. -->
                    <TextBlock Text="{DynamicResource S.Backstage.Characters}" Style="{StaticResource BackstageSectionLabel}" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,0,8" AutomationProperties.Name="{DynamicResource S.Backstage.Characters}">
                    <StackPanel Orientation="Horizontal">
                    <ItemsControl ItemsSource="{Binding HomeCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeCharacterCardViewModel}">
                                <Button Style="{StaticResource BackstageCharacterChip}" Click="BackstageCharacter_OnClick">
                                    <Grid>
                                        <!-- Existing character -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                                                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                <TextBlock Text="{Binding Character.Initials}" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse IsHitTestVisible="False">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Character.AvatarPath}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Text="{Binding Character.Name}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,9,0,0" MaxWidth="102" />
                                        </StackPanel>
                                        <!-- Add-character dashed chip -->
                                        <StackPanel Visibility="Collapsed">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                                                <Ellipse Fill="{StaticResource GlassPanelBrush}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                                <TextBlock Text="+" FontSize="30" FontWeight="Light" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{DynamicResource S.Backstage.NewCharacter}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,9,0,0" MaxWidth="102" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource BackstageCharacterChip}" Click="CreateCharacterFromBackstage_OnClick" ToolTip="Создать персонажа" AutomationProperties.Name="Создать персонажа">
                        <StackPanel>
                            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                                <Ellipse Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                <TextBlock Text="+" FontSize="32" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                            <TextBlock Text="Создать персонажа" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,9,0,0" MaxWidth="112" />
                        </StackPanel>
                    </Button>
                    </StackPanel>
                    </ScrollViewer>

                    <TextBlock Text="БИБЛИОТЕКА" Style="{StaticResource BackstageSectionLabel}" />
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" AutomationProperties.Name="Библиотека">
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Home" Click="BackstageWorld_OnClick" Tag="characters" AutomationProperties.Name="Персонажи" TabIndex="0">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B7;" Style="{StaticResource BackstageIcon}" /><StackPanel><TextBlock Text="Персонажи" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Карточки и редактор" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,3,0,0" /></StackPanel></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Home" Click="BackstageWorld_OnClick" Tag="personas" AutomationProperties.Name="Персоны" TabIndex="1">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE77B;" Style="{StaticResource BackstageIcon}" /><StackPanel><TextBlock Text="Персоны" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Профили для диалогов" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,3,0,0" /></StackPanel></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Home" Click="BackstageWorld_OnClick" Tag="lore" AutomationProperties.Name="Лоры" TabIndex="2">
                            <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE82D;" Style="{StaticResource BackstageIcon}" /><StackPanel><TextBlock Text="Лоры" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Мир и правила истории" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="10,3,0,0" /></StackPanel></StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Gateway" Click="BackstageNav_OnClick" AutomationProperties.Name="Хаб" TabIndex="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Хаб" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Внешние материалы и каталоги" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock Text="НАСТРОЙКИ" Style="{StaticResource BackstageSectionLabel}" />
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" AutomationProperties.Name="Настройки">
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageOptions_OnClick" Tag="setup" AutomationProperties.Name="Быстрый старт" TabIndex="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8FB;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Быстрый старт" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Первичная настройка" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageOptions_OnClick" Tag="llm" AutomationProperties.Name="Runtime" TabIndex="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE950;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Runtime" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Параметры генерации" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageOptions_OnClick" Tag="models" AutomationProperties.Name="Модели" TabIndex="2">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Модели" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Установленные модели" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageOptions_OnClick" Tag="appearance" AutomationProperties.Name="Оформление" TabIndex="3">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE790;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Оформление" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Тема и фон чатов" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageOptions_OnClick" Tag="mobile" AutomationProperties.Name="Мобильный" TabIndex="4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8EA;" Style="{StaticResource BackstageIcon}" />
                                <StackPanel><TextBlock Text="Мобильный" Style="{StaticResource BackstageLabel}" /><TextBlock Text="Подключение мобильного приложения" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="10,3,0,0" /></StackPanel>
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Layer 5: initial setup overlay — glass sheet over the stage scrim. -->
        <Grid x:Name="SetupOverlay" Grid.RowSpan="2" Panel.ZIndex="100" Background="#F2060810" KeyboardNavigation.TabNavigation="Cycle">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitialSetupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border MaxWidth="1040" MaxHeight="680" Margin="40" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20" Effect="{StaticResource CardShadowEffect}" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="{DynamicResource S.Setup.WelcomeTitle}" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding InitialSetupStepTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="1,4,0,20" />
                    <views:SetupView x:Name="InitialSetupView" Grid.Row="2" />
                </Grid>
            </Border>
        </Grid>

        <!-- Layer 6: window chrome buttons. CaptionHeight is 1, so these are plain
             client-area buttons floating above every route. -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,14,20,0" Panel.ZIndex="210">
            <Button Click="MinimizeWindowButton_OnClick" Style="{StaticResource StageWindowButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Window.Minimize}" ToolTip="{DynamicResource S.Window.Minimize}" />
            <Button Click="ToggleMaximizeWindowButton_OnClick" AutomationProperties.Name="{DynamicResource S.Window.Maximize}" FontFamily="Segoe MDL2 Assets">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource StageWindowButton}">
                        <Setter Property="Content" Value="&#xE922;" />
                        <Setter Property="ToolTip" Value="{DynamicResource S.Window.Maximize}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;" />
                                <Setter Property="ToolTip" Value="{DynamicResource S.Window.Restore}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Click="CloseWindowButton_OnClick" Style="{StaticResource StageWindowCloseButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Window.Close}" ToolTip="{DynamicResource S.Window.Close}" />
        </StackPanel>
    </Grid>
</UserControl>
