<UserControl x:Class="SoulExe.Views.StageShellView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:SoulExe.Views"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
             PreviewKeyDown="StageShellView_OnPreviewKeyDown"
             Loaded="StageShellView_OnLoaded"
             Unloaded="StageShellView_OnUnloaded">
    <UserControl.Resources>
        <!-- Local-only styles. Never register implicit templates for layout controls here. -->
        <Style x:Key="StageGlassPanel" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="18" />
        </Style>
        <Style x:Key="StageTopIconButton" TargetType="Button" BasedOn="{StaticResource CircleIconButton}">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
        </Style>
        <Style x:Key="StageModelChipButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource GlassPanelBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageCard" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="252" />
            <Setter Property="Height" Value="118" />
            <Setter Property="Margin" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="20" Padding="20">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BackstageIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Margin" Value="14,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="BackstageSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="Margin" Value="2,30,0,12" />
        </Style>
        <!-- Conversation card in the "Continue" rail: glass surface over the scrimmed stage. -->
        <Style x:Key="BackstageConversationCard" TargetType="Button">
            <Setter Property="Width" Value="272" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
                            <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                <Setter TargetName="Card" Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Character chip in the "Characters" gallery. -->
        <Style x:Key="BackstageCharacterChip" TargetType="Button">
            <Setter Property="Width" Value="118" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Card" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" CornerRadius="16" Padding="8,12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{StaticResource GlassPanelBrush}" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource GlassBorderBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Layer 0: ambient character art, blurred and scrimmed so any message stays readable. -->
        <Grid ClipToBounds="True">
            <Image x:Name="AmbientImage" Stretch="UniformToFill" Opacity="0.5" RenderTransformOrigin="0.5,0.5">
                <Image.Style>
                    <Style TargetType="Image">
                        <Setter Property="Source" Value="{Binding SelectedCharacter.AvatarPath}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                <Setter Property="Source" Value="{Binding SelectedSceneCharacterA.AvatarPath}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
                <Image.Effect>
                    <BlurEffect Radius="70" />
                </Image.Effect>
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="1.15" ScaleY="1.15" />
                </Image.RenderTransform>
            </Image>
            <Border Background="{StaticResource StageScrimBrush}" />
        </Grid>

        <!-- Layer 1: the stage itself (active conversation). -->
        <ContentControl x:Name="StageHost" />

        <!-- Layer 2: full-page host for non-stage routes during the transition phases. -->
        <Grid x:Name="PageOverlay" Visibility="Collapsed" Background="{StaticResource WindowBrush}" MouseLeftButtonDown="ChromeArea_OnMouseLeftButtonDown">
            <ContentControl x:Name="PageHost" Margin="24,16,140,20" />
            <Button Command="{Binding NavigateCommand}" CommandParameter="Chat" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" Style="{StaticResource StageModelChipButton}" Padding="16,9" AutomationProperties.Name="{DynamicResource S.Stage.BackToStage}" ToolTip="{DynamicResource S.Stage.BackToStage}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets" FontSize="12" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Stage.BackToStage}" FontSize="12" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Layer 3: floating top bar. Transparent background makes its empty band the
             window drag area (CaptionHeight is 1, so nothing native steals clicks). -->
        <Grid x:Name="TopBar" VerticalAlignment="Top" Margin="20,14,140,0" Background="Transparent" MouseLeftButtonDown="TopBar_OnMouseLeftButtonDown">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Click="BackstageButton_OnClick" Style="{StaticResource StageTopIconButton}" Content="&#xE700;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Stage.Menu}" ToolTip="{DynamicResource S.Stage.Menu}" />

            <!-- Presence pill: personal and scene variants. -->
            <Border Grid.Column="1" Style="{StaticResource StageGlassPanel}" Padding="12,7" HorizontalAlignment="Center" VerticalAlignment="Center" MinHeight="56" MaxWidth="520" Cursor="Hand" MouseLeftButtonDown="Presence_OnMouseLeftButtonDown" AutomationProperties.Name="{Binding SelectedCharacter.Name, FallbackValue=''}">
                <Grid>
                    <!-- Personal presence -->
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="{Binding SelectedCharacter.Initials}" FontWeight="Bold" FontSize="13" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="11,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedCharacter.Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="300" />
                            <TextBlock Text="{Binding ModelState}" FontSize="10.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="300">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{DynamicResource S.Stage.Presence.Typing}" FontStyle="Italic" FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                    <!-- Scene presence -->
                    <StackPanel Orientation="Horizontal" Visibility="Collapsed">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Grid Width="58" Height="40">
                            <Ellipse Width="34" Height="34" HorizontalAlignment="Left" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                            <TextBlock Text="{Binding SelectedSceneCharacterA.Initials}" Width="34" HorizontalAlignment="Left" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" />
                            <Ellipse Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                            <TextBlock Text="{Binding SelectedSceneCharacterB.Initials}" Width="26" Height="26" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Center" Padding="0,6,0,0" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Grid>
                        <StackPanel Margin="10,0,4,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SceneParticipantNames}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" MaxWidth="340" />
                            <TextBlock Text="{DynamicResource S.Stage.Presence.Typing}" FontStyle="Italic" FontSize="10.5" Foreground="{StaticResource AccentHoverBrush}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsSceneTyping}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right cluster: settings gear + model chip with its flyout menu. -->
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Command="{Binding NavigateCommand}" CommandParameter="Options" Style="{StaticResource StageTopIconButton}" Content="&#xE713;" FontFamily="Segoe MDL2 Assets" AutomationProperties.Name="{DynamicResource S.Nav.Options}" ToolTip="{DynamicResource S.Nav.Options}" />
                <Button x:Name="ModelChip" Click="ModelChip_OnClick" Margin="10,0,0,0" Style="{StaticResource StageModelChipButton}" Padding="14,8" AutomationProperties.Name="{DynamicResource S.Stage.Model}" ToolTip="{Binding ModelState}">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="28" Padding="{TemplateBinding Padding}">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                        <TextBlock Text="{Binding ModelState}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="190" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Popup x:Name="ModelChipPopup" PlacementTarget="{Binding ElementName=ModelChip}" Placement="Top" VerticalOffset="12" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                    <Border Style="{StaticResource StageGlassPanel}" Width="320" Padding="16" Background="#EE141826">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                                    <Setter Property="Background" Value="{StaticResource SuccessBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{DynamicResource S.Stage.Model}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextMutedBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding ModelState}" FontSize="13" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding ModelDownloadStatus}" FontSize="11" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
                            <Button Content="{Binding ModelStartStopText}" Command="{Binding ToggleModelStartStopCommand}" Style="{StaticResource AccentButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" />
                            <Button Content="{Binding ModelDownloadPauseResumeText}" Command="{Binding ToggleModelDownloadCommand}" Margin="0,8,0,0" HorizontalAlignment="Stretch">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelDownloadInProgress}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CanResumeModelDownload}" Value="True">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Separator Margin="0,14,0,6" Background="{StaticResource BorderBrush}" />
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Models" Click="ModelChipNav_OnClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7F8;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Tab.Models}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Options" Click="ModelChipNav_OnClick" Style="{StaticResource GhostButton}" HorizontalContentAlignment="Left" Padding="10,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{DynamicResource S.Nav.Options}" Margin="10,0,0,0" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </Popup>
            </StackPanel>
        </Grid>

        <!-- Layer 4: Backstage overlay-hub. Sections: Continue rail, Characters gallery, system cards. -->
        <Grid x:Name="BackstageOverlay" Visibility="Collapsed" Background="#F2060710" KeyboardNavigation.TabNavigation="Cycle" MouseLeftButtonDown="ChromeArea_OnMouseLeftButtonDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel MaxWidth="1020" Margin="40,54,40,44" HorizontalAlignment="Center">
                    <TextBlock Text="SoulExe" FontSize="32" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock Text="{DynamicResource S.Backstage.Subtitle}" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" HorizontalAlignment="Center" Margin="0,6,0,4" />

                    <!-- Продолжить: recent conversations as glass cards over the stage scrim. -->
                    <TextBlock Text="{DynamicResource S.Backstage.Continue}" Style="{StaticResource BackstageSectionLabel}" />
                    <TextBlock Text="{DynamicResource S.Backstage.Continue.Empty}" FontSize="12.5" Foreground="{StaticResource TextMutedBrush}" Margin="2,2,0,6">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ConversationItems.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding ConversationItems}" AutomationProperties.Name="{DynamicResource S.Backstage.Continue}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConversationListItemViewModel}">
                                <Button Style="{StaticResource BackstageConversationCard}" Click="BackstageConversation_OnClick" AutomationProperties.Name="{Binding Title}" ToolTip="{Binding Preview}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="46" Height="46" VerticalAlignment="Top">
                                            <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                            <TextBlock Text="{Binding AvatarAInitials}" FontWeight="SemiBold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Ellipse IsHitTestVisible="False">
                                                <Ellipse.Fill>
                                                    <ImageBrush ImageSource="{Binding AvatarAPath}" Stretch="UniformToFill" />
                                                </Ellipse.Fill>
                                            </Ellipse>
                                            <Border Width="24" Height="24" CornerRadius="12" BorderBrush="#F2060710" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasSecondAvatar}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                    <TextBlock Text="{Binding AvatarBInitials}" FontSize="7.5" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    <Ellipse Stroke="#F2060710" StrokeThickness="2">
                                                        <Ellipse.Fill>
                                                            <ImageBrush ImageSource="{Binding AvatarBPath}" Stretch="UniformToFill" />
                                                        </Ellipse.Fill>
                                                    </Ellipse>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,2,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                            <TextBlock Text="{Binding TypeLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Персонажи: horizontal gallery, add-card last (VM contract). -->
                    <TextBlock Text="{DynamicResource S.Backstage.Characters}" Style="{StaticResource BackstageSectionLabel}" />
                    <ItemsControl ItemsSource="{Binding HomeCards}" AutomationProperties.Name="{DynamicResource S.Backstage.Characters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:HomeCharacterCardViewModel}">
                                <Button Style="{StaticResource BackstageCharacterChip}" Click="BackstageCharacter_OnClick">
                                    <Grid>
                                        <!-- Existing character -->
                                        <StackPanel>
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                                                <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                                                <TextBlock Text="{Binding Character.Initials}" FontSize="15" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                <Ellipse IsHitTestVisible="False">
                                                    <Ellipse.Fill>
                                                        <ImageBrush ImageSource="{Binding Character.AvatarPath}" Stretch="UniformToFill" />
                                                    </Ellipse.Fill>
                                                </Ellipse>
                                            </Grid>
                                            <TextBlock Text="{Binding Character.Name}" FontSize="11.5" Foreground="{StaticResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,9,0,0" MaxWidth="102" />
                                        </StackPanel>
                                        <!-- Add-character dashed chip -->
                                        <StackPanel Visibility="Collapsed">
                                            <StackPanel.Style>
                                                <Style TargetType="StackPanel">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </StackPanel.Style>
                                            <Grid Width="66" Height="66" HorizontalAlignment="Center">
                                                <Ellipse Fill="{StaticResource GlassPanelBrush}" Stroke="{StaticResource AccentHoverBrush}" StrokeThickness="1.5" StrokeDashArray="3 2" />
                                                <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="18" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{DynamicResource S.Backstage.NewCharacter}" FontSize="11.5" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,9,0,0" MaxWidth="102" />
                                        </StackPanel>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Destinations: world/catalog/system. -->
                    <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,34,0,0" AutomationProperties.Name="{DynamicResource S.Backstage.Title}">
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Home" Click="BackstageNav_OnClick" AutomationProperties.Name="{DynamicResource S.Backstage.World}" TabIndex="0">
                            <StackPanel>
                                <TextBlock Text="&#xE8F1;" Style="{StaticResource BackstageIcon}" />
                                <TextBlock Text="{DynamicResource S.Backstage.World}" Style="{StaticResource BackstageLabel}" Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource S.Nav.Home.Hint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Gateway" Click="BackstageNav_OnClick" AutomationProperties.Name="{DynamicResource S.Nav.Gateway}" TabIndex="1">
                            <StackPanel>
                                <TextBlock Text="&#xE774;" Style="{StaticResource BackstageIcon}" />
                                <TextBlock Text="{DynamicResource S.Nav.Gateway}" Style="{StaticResource BackstageLabel}" Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource S.Nav.Gateway.Hint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Models" Click="BackstageNav_OnClick" AutomationProperties.Name="{DynamicResource S.Tab.Models}" TabIndex="2">
                            <StackPanel>
                                <TextBlock Text="&#xE7F8;" Style="{StaticResource BackstageIcon}" />
                                <TextBlock Text="{DynamicResource S.Tab.Models}" Style="{StaticResource BackstageLabel}" Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource S.Nav.Models.Hint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BackstageCard}" Command="{Binding NavigateCommand}" CommandParameter="Options" Click="BackstageNav_OnClick" AutomationProperties.Name="{DynamicResource S.Nav.Options}" TabIndex="3">
                            <StackPanel>
                                <TextBlock Text="&#xE713;" Style="{StaticResource BackstageIcon}" />
                                <TextBlock Text="{DynamicResource S.Nav.Options}" Style="{StaticResource BackstageLabel}" Margin="0,12,0,0" />
                                <TextBlock Text="{DynamicResource S.Nav.Options.Hint}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Layer 5: initial setup overlay (unchanged behaviour from AppShellView). -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="100" Background="{StaticResource OverlayBrush}" Visibility="Collapsed">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsInitialSetupVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Border MaxWidth="1040" MaxHeight="650" Margin="24" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="18" Padding="32" HorizontalAlignment="Center" VerticalAlignment="Center" FocusManager.IsFocusScope="True" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Добро пожаловать в SoulExe" FontSize="27" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="{Binding InitialSetupStepTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="1,4,0,20" />
                    <views:SetupView x:Name="InitialSetupView" Grid.Row="2" />
                </Grid>
            </Border>
        </Grid>

        <!-- Layer 6: window chrome buttons. CaptionHeight is 1, so these are plain
             client-area buttons floating above every route. -->
        <StackPanel VerticalAlignment="Top" HorizontalAlignment="Right" Orientation="Horizontal" Margin="0,10,12,0" Panel.ZIndex="210">
            <Button Click="MinimizeWindowButton_OnClick" Style="{StaticResource WindowChromeButton}" Content="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" AutomationProperties.Name="Свернуть окно" ToolTip="Свернуть" />
            <Button Click="ToggleMaximizeWindowButton_OnClick" AutomationProperties.Name="Развернуть или восстановить окно" FontFamily="Segoe MDL2 Assets" FontSize="10">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
                        <Setter Property="Content" Value="&#xE922;" />
                        <Setter Property="ToolTip" Value="Развернуть" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                <Setter Property="Content" Value="&#xE923;" />
                                <Setter Property="ToolTip" Value="Восстановить размер" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
            <Button Click="CloseWindowButton_OnClick" Style="{StaticResource WindowCloseButton}" Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" AutomationProperties.Name="Закрыть окно" ToolTip="Закрыть" />
        </StackPanel>
    </Grid>
</UserControl>
