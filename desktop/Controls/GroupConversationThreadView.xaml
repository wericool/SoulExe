<UserControl x:Class="SoulExe.Controls.GroupConversationThreadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:controls="clr-namespace:SoulExe.Controls">
<Border Grid.Column="2" Panel.ZIndex="20" Background="{Binding ChatAppearance.ChatBackgroundColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0" ClipToBounds="True">
    <Border.Style>
        <Style TargetType="Border">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
            <Grid>
                <DockPanel LastChildFill="False">
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="63" Height="40">
                            <Ellipse Width="40" Height="40" HorizontalAlignment="Left" Fill="{StaticResource AccentSoftBrush}" />
                            <TextBlock Text="{Binding SelectedSceneCharacterA.Initials}" Width="40" HorizontalAlignment="Left" VerticalAlignment="Center" TextAlignment="Center" FontSize="11" FontWeight="Bold" Foreground="White" />
                            <Ellipse Width="40" Height="40" HorizontalAlignment="Left">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedSceneCharacterA.AvatarPath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <Ellipse Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" />
                            <TextBlock Text="{Binding SelectedSceneCharacterB.Initials}" Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" TextAlignment="Center" Padding="0,8,0,0" FontSize="8" FontWeight="Bold" Foreground="White" IsHitTestVisible="False" />
                            <Ellipse Width="28" Height="28" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" IsHitTestVisible="False">
                                <Ellipse.Fill>
                                    <ImageBrush ImageSource="{Binding SelectedSceneCharacterB.AvatarPath}" Stretch="UniformToFill" />
                                </Ellipse.Fill>
                            </Ellipse>
                        </Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SceneParticipantNames}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding SceneLastMessageLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" MaxWidth="400" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedGroupConversation.Name}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="170" Margin="0,0,12,0" />
                        <Button Content="⌕" Command="{Binding ToggleSceneMessageSearchCommand}" Style="{StaticResource CircleIconButton}" ToolTip="Поиск по репликам этого разговора" Margin="0,0,6,0" />
                        <Button Content="..." Style="{StaticResource CircleIconButton}" ToolTip="Действия с разговором" Click="MessageMenuButton_OnClick" Tag="{Binding}">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                    <MenuItem Header="{Binding PlacementTarget.Tag.SelectedConversationItem.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleConversationPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <MenuItem Header="✎  Переименовать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                    <Separator />
                                    <MenuItem Header="🗑  Удалить разговор" Style="{StaticResource ChatActionMenuItem}" Foreground="#FB7185" Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="11,6" Panel.ZIndex="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSceneCountdownVisible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="◷" Foreground="{StaticResource AccentHoverBrush}" FontSize="13" Margin="0,0,6,0" />
                        <TextBlock Text="{Binding SceneCountdownText}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="11.5" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
        <Border Grid.Row="1" Panel.ZIndex="12" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Effect="{StaticResource AccentGlowEffect}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsSceneMessageSearchOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseSceneMessageSearchCommand}" Style="{StaticResource CircleIconButton}" ToolTip="Закрыть поиск" />
                    <TextBlock Text="Поиск в групповом разговоре" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,10,0,8" Padding="9,0">
                    <DockPanel>
                        <TextBlock Text="⌕" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding SceneMessageSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" MinHeight="32" Padding="0" VerticalContentAlignment="Center" ToolTip="Введите текст для поиска по репликам" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding SceneMessageSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageSearchResult}">
                                <Button Command="{Binding DataContext.SelectSceneMessageSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,8" HorizontalContentAlignment="Stretch" ToolTip="Перейти к найденной реплике">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <ScrollViewer x:Name="SceneMessagesScroll" Grid.Row="1" Style="{StaticResource ConversationMessageScroller}">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding SceneMessages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SceneMessageViewModel}">
                                <Border x:Name="SceneBubble" Margin="0,7" Padding="12,10" CornerRadius="{Binding DataContext.ChatAppearance.BubbleCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="{Binding DataContext.ChatAppearance.BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
                                    <StackPanel>
                                        <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Border x:Name="SceneAvatar" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0">
                                                    <Grid>
                                                        <TextBlock Text="{Binding SpeakerInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                        <Ellipse IsHitTestVisible="False">
                                                            <Ellipse.Fill>
                                                                <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                    </Grid>
                                                </Border>
                                                <TextBlock x:Name="SceneSpeaker" Text="{Binding SpeakerName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DockPanel>
                                        <DockPanel LastChildFill="True" Margin="0,1,0,0">
                                            <TextBlock x:Name="SceneTime" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                            <ui:SelectableFormattedChatBox x:Name="SceneText" ContentText="{Binding Content}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,2,0" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                                        <Setter TargetName="SceneBubble" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                        <Setter TargetName="SceneBubble" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsFirstCharacter}" Value="True">
                                        <Setter TargetName="SceneBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="SceneBubble" Property="Background" Value="{Binding DataContext.ChatAppearance.UserBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="SceneBubble" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="SceneText" Property="Foreground" Value="White" />
                                        <Setter TargetName="SceneSpeaker" Property="Foreground" Value="White" />
                                        <Setter TargetName="SceneAvatar" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="SceneTime" Property="Foreground" Value="#D8CCFF" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUserParticipant}" Value="True">
                                        <Setter TargetName="SceneBubble" Property="HorizontalAlignment" Value="Center" />
                                        <Setter TargetName="SceneBubble" Property="Background" Value="{StaticResource ElevatedBrush}" />
                                        <Setter TargetName="SceneBubble" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirector}" Value="True">
                                        <Setter TargetName="SceneBubble" Property="HorizontalAlignment" Value="Center" />
                                        <Setter TargetName="SceneBubble" Property="Background" Value="{StaticResource ElevatedBrush}" />
                                        <Setter TargetName="SceneAvatar" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{Binding ChatAppearance.AssistantBubbleColor}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ConversationTypingBubble}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSceneTyping}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock Text="Персонаж печатает…" VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <controls:ConversationComposerView Grid.Row="2" Tag="Group" />
    </Grid>
</Border>
</UserControl>
