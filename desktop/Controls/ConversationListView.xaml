<UserControl x:Class="SoulExe.Controls.ConversationListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulExe.ViewModels">
    <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Margin="18,18,18,14" Text="Диалоги" FontSize="18" FontWeight="SemiBold" />
            <Grid Grid.Row="1" Margin="16,0,16,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="112"/></Grid.ColumnDefinitions>
                <Border Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="12,0">
                    <DockPanel>
                        <TextBlock Text="⌕" Foreground="{StaticResource TextMutedBrush}" FontSize="15" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox Text="{Binding ChatSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Padding="0" MinHeight="38" FontSize="12.5" VerticalContentAlignment="Center" ToolTip="Поиск по имени, названию и последнему сообщению" />
                    </DockPanel>
                </Border>
                <ComboBox Grid.Column="2" ItemsSource="{Binding ChatCharacterSortOptions}" SelectedValuePath="Id" SelectedValue="{Binding ChatCharacterSortMode}" FontSize="11" ToolTip="Сортировка диалогов" />
            </Grid>
            <ListBox Grid.Row="2" ItemsSource="{Binding ConversationItems}" SelectedItem="{Binding SelectedConversationItem}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" Padding="8,0,8,6">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,3"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" Background="Transparent" CornerRadius="12"><Grid><Border x:Name="Rail" Width="3" HorizontalAlignment="Left" CornerRadius="2" Background="Transparent" Margin="0,7"/><ContentPresenter Margin="5,0,0,0"/></Grid></Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ListHoverBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{StaticResource ListSelectedBrush}"/><Setter TargetName="Rail" Property="Background" Value="{StaticResource AccentBrush}"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:ConversationListItemViewModel}">
                        <Grid Margin="9,10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Grid Width="48" Height="48" VerticalAlignment="Top">
                                <Ellipse Fill="{StaticResource AccentSoftBrush}"/><TextBlock Text="{Binding AvatarAInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="12" Foreground="White"/><Ellipse IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarAPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                                <Grid Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                    <Grid.Style><Style TargetType="Grid"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasSecondAvatar}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Grid.Style>
                                    <Ellipse Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2"/><TextBlock Text="{Binding AvatarBInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="White"/><Ellipse Stroke="{StaticResource PanelBrush}" StrokeThickness="2"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarBPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse>
                                </Grid>
                            </Grid>
                            <StackPanel Grid.Column="1" Margin="12,0,8,0">
                                <DockPanel><Border DockPanel.Dock="Right" Background="{StaticResource AccentSoftBrush}" CornerRadius="5" Padding="5,2" Margin="6,0,0,0"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding HasTypeBadge}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding TypeBadge}" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentHoverBrush}"/></Border><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13.5" TextTrimming="CharacterEllipsis"/></DockPanel>
                                <TextBlock Text="{Binding Preview}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock Text="{Binding SecondaryTitle}" Foreground="{StaticResource TextDimBrush}" FontSize="10" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Right">
                                <DockPanel HorizontalAlignment="Right" Margin="0,1,0,5"><TextBlock Text="{Binding TimeLabel}" DockPanel.Dock="Right" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/><TextBlock Text="{Binding PinIcon}" Foreground="{StaticResource AccentHoverBrush}" FontSize="13" FontFamily="Segoe UI Emoji" Margin="0,-1,7,0"/></DockPanel>
                                <Button Content="..." Width="28" Height="28" FontSize="12" FontWeight="Bold" ToolTip="Действия с диалогом" Click="MenuButton_OnClick" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource CircleIconButton}">
                                    <Button.ContextMenu><ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                        <MenuItem Header="{Binding PlacementTarget.DataContext.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleConversationPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="✎  Переименовать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                        <MenuItem Header="＋  Новый разговор с персонажем" Command="{Binding PlacementTarget.Tag.CreateChatForCharacterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext.ChatItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}">
                                            <MenuItem.Style><Style TargetType="MenuItem" BasedOn="{StaticResource ChatActionMenuItem}"><Style.Triggers><DataTrigger Binding="{Binding PlacementTarget.DataContext.IsScene, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></MenuItem.Style>
                                        </MenuItem>
                                        <Separator/><MenuItem Header="🗑  Удалить" Style="{StaticResource ChatActionMenuItem}" Foreground="#FB7185" Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"/>
                                    </ContextMenu></Button.ContextMenu>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Row="3" Content="＋  Новый разговор" Command="{Binding AddChatCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Margin="16,10,16,16" Padding="12,11"/>
        </Grid>
    </Border>
</UserControl>
