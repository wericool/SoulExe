<UserControl x:Class="SoulExe.Controls.PersonalConversationThreadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:controls="clr-namespace:SoulExe.Controls">
<Border Grid.Column="2" Background="{Binding ChatAppearance.ChatBackgroundColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="18,13">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="40" Height="40">
                        <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                        <TextBlock Text="{Binding SelectedCharacter.Initials}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedCharacter.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedChatLastMessageLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedChatHeaderTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" Margin="0,0,12,0" />
                        <Button Content="⌕" Command="{Binding ToggleChatMessageSearchCommand}" Style="{StaticResource CircleIconButton}" ToolTip="Поиск по сообщениям в этом разговоре" Margin="0,0,6,0" />
                        <Button Content="..." Style="{StaticResource CircleIconButton}" ToolTip="Действия с разговором" Click="MessageMenuButton_OnClick" Tag="{Binding}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                <MenuItem Header="{Binding PlacementTarget.Tag.SelectedChatListItem.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleChatPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="✎  Переименовать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="＋  Новый разговор с персонажем" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.CreateChatForCharacterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="🗑  Удалить разговор" Style="{StaticResource ChatActionMenuItem}" Foreground="#FB7185" Command="{Binding PlacementTarget.Tag.DeleteChatListItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" Panel.ZIndex="12" Width="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,20,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Effect="{StaticResource AccentGlowEffect}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChatMessageSearchOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="×" Command="{Binding CloseChatMessageSearchCommand}" Style="{StaticResource CircleIconButton}" ToolTip="Закрыть поиск" />
                    <TextBlock Text="Поиск в диалоге" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,10,0,8" Padding="9,0">
                    <DockPanel>
                        <TextBlock Text="⌕" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ChatMessageSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" MinHeight="32" Padding="0" VerticalContentAlignment="Center" ToolTip="Введите текст для поиска по сообщениям" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatMessageSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageSearchResult}">
                                <Button Command="{Binding DataContext.SelectChatMessageSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,8" HorizontalContentAlignment="Stretch" ToolTip="Подсветить найденное сообщение в ленте">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <ScrollViewer x:Name="ChatMessagesScroll" Grid.Row="1" Style="{StaticResource ConversationMessageScroller}">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <StackPanel>
                                    <Border HorizontalAlignment="Center" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="11,5" Margin="0,12,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDateSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DateSeparatorLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                    </Border>
                                    <Border x:Name="MessageBubble" Margin="0,7" Padding="12,10" CornerRadius="{Binding DataContext.ChatAppearance.BubbleCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="{Binding DataContext.ChatAppearance.BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <!-- Compact header: avatar, author and actions share one line. -->
                                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="..." Style="{StaticResource CircleIconButton}" Width="26" Height="26" FontSize="11" FontWeight="Bold" Padding="0" Margin="8,-2,0,0" ToolTip="Действия с сообщением" Click="MessageMenuButton_OnClick" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                                            <MenuItem Header="↪  Продолжить с этого сообщения" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ContinueFromMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="✎  Редактировать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginEditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="🗑  Удалить сообщение" Style="{StaticResource ChatActionMenuItem}" Foreground="#FB7185" Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="MessageAvatar" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding AuthorInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            <Ellipse IsHitTestVisible="False">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock x:Name="MessageAuthor" Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,1,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThoughtContent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Button Content="{Binding ThoughtToggleText}" Command="{Binding ToggleThoughtCommand}" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" HorizontalContentAlignment="Left" Padding="2" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ThoughtContent}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12" Margin="3,7,3,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThoughtExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!-- The time occupies its own right column, so wrapped text cannot overlap it. -->
                                                <DockPanel LastChildFill="True" Margin="0,1,0,0">
                                                    <TextBlock x:Name="MessageTime" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                                    <ui:SelectableFormattedChatBox x:Name="MessageText" ContentText="{Binding VisibleContent}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,2,0" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResponseVariants}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Content="◀" Command="{Binding DataContext.PreviousVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" />
                                                    <TextBlock Text="{Binding CurrentVariantNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0" />
                                                    <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VariantCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0" />
                                                    <Button Content="▶" Command="{Binding DataContext.NextVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBox Text="{Binding EditingContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button Content="Отмена" Command="{Binding DataContext.CancelEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" />
                                                    <Button Content="Сохранить" Command="{Binding DataContext.SaveEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource AccentButton}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{Binding DataContext.ChatAppearance.UserBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="White" />
                                        <Setter TargetName="MessageAvatar" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="MessageAuthor" Property="Foreground" Value="White" />
                                        <Setter TargetName="MessageTime" Property="Foreground" Value="#D8CCFF" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Background="{Binding ChatAppearance.AssistantBubbleColor}">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ConversationTypingBubble}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Text="…" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic">
                                <Run Text="{Binding SelectedCharacter.Name}" />
                                <Run Text=" печатает…" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <controls:ConversationComposerView Grid.Row="2" Tag="Personal" />
    </Grid>
</Border>
</UserControl>
