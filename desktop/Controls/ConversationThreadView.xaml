<UserControl x:Class="SoulTextWpf.Controls.ConversationThreadView"
             x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoulTextWpf"
             xmlns:vm="clr-namespace:SoulTextWpf.ViewModels">
    <Grid Background="{Binding DataContext.ChatAppearance.ChatBackgroundColor, RelativeSource={RelativeSource AncestorType=Window}}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,14,24,12">
            <Grid MinHeight="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                <StackPanel VerticalAlignment="Bottom">
                    <ItemsControl ItemsSource="{Binding Thread.Messages, ElementName=Root}">
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter"><Setter Property="HorizontalAlignment" Value="Stretch"/></Style>
                        </ItemsControl.ItemContainerStyle>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ConversationThreadMessagePresentationViewModel}">
                                <StackPanel>
                                    <Border HorizontalAlignment="Center" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="999" Padding="11,5" Margin="0,12,0,8">
                                        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding ShowDateSeparator}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
                                        <TextBlock Text="{Binding DateSeparatorLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5"/>
                                    </Border>
                                    <Border x:Name="Bubble" Margin="0,7" Padding="12,10" CornerRadius="{Binding DataContext.ChatAppearance.BubbleCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="{Binding DataContext.ChatAppearance.BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <StackPanel x:Name="AuthorLine" Orientation="Horizontal" Margin="0,0,0,4">
                                                <Border x:Name="Avatar" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0">
                                                    <Grid><TextBlock Text="{Binding AuthorInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8.5" FontWeight="Bold" Foreground="White"/><Ellipse IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill"/></Ellipse.Fill></Ellipse></Grid>
                                                </Border>
                                                <TextBlock x:Name="Author" Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                            <DockPanel LastChildFill="True"><TextBlock x:Name="Time" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1"/><ui:SelectableFormattedChatBox x:Name="MessageText" ContentText="{Binding Content}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,2,0"/></DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsOutgoing}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="Bubble" Property="Background" Value="{Binding DataContext.ChatAppearance.UserBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}"/><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentBrush}"/><Setter TargetName="MessageText" Property="Foreground" Value="White"/><Setter TargetName="Avatar" Property="Background" Value="{StaticResource AccentBrush}"/><Setter TargetName="Author" Property="Foreground" Value="White"/><Setter TargetName="Time" Property="Foreground" Value="#D8CCFF"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsDirector}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}"/><Setter TargetName="Avatar" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                    <DataTrigger Binding="{Binding IsSystem}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center"/><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}"/><Setter TargetName="AuthorLine" Property="Visibility" Value="Collapsed"/></DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="История пока пуста." Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,24" Visibility="Collapsed"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
