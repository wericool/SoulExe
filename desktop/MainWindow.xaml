                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Добро пожаловать в SoulExe" FontSize="27" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding InitialSetupStepTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="1,4,0,0" />
                                </StackPanel>
                                <Border DockPanel.Dock="Right" Background="{StaticResource CardHoverBrush}" CornerRadius="12" Padding="12,7" VerticalAlignment="Center">
                                    <TextBlock Text="Только локальная LLM • данные рядом с EXE" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                </Border>
                            </DockPanel>
                            <Grid Grid.Row="1" Margin="0,28,0,20">
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitialSetupEngineStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="1. Выберите сборку llama.cpp" FontSize="23" FontWeight="SemiBold" />
                                        <TextBlock Text="Выберите один вариант ниже. Нажатие на карточку сразу скачает и установит соответствующий llama-server.exe в SoulExeData рядом с программой. После успешной установки станет доступна кнопка «Далее: выбрать модель»." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,7,0,16" />
                                    </StackPanel>
                                    <UniformGrid Grid.Row="1" Rows="2" Columns="3" Margin="0,0,0,16">
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="CPU" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Подходит для любого ПК. Выбирайте, если нет подходящей видеокарты или вы не уверены." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Не требует GPU; самый совместимый вариант." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать CPU" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="cpu" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="CUDA 12 — NVIDIA" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Для видеокарт NVIDIA с рабочим драйвером. Безопасный выбор для большинства совместимых NVIDIA GPU." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Выберите, если CUDA 13 вам не требуется или вы сомневаетесь." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать CUDA 12" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="cuda12" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="CUDA 13 — NVIDIA" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Для NVIDIA GPU с самым актуальным драйвером. Может быть быстрее на новых видеокартах." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Выбирайте только при современном NVIDIA-драйвере; иначе используйте CUDA 12." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать CUDA 13" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="cuda13" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="Vulkan" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Универсальный вариант для GPU с корректным Vulkan-драйвером: NVIDIA, AMD или Intel." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Полезен как запасной GPU-вариант, когда CUDA, ROCm или SYCL не подходят." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать Vulkan" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="vulkan" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="ROCm / HIP — AMD" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Для поддерживаемых видеокарт AMD с совместимым драйвером и ROCm runtime." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Не выбирайте для NVIDIA или Intel. Если ROCm не запускается, попробуйте Vulkan." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать ROCm / HIP" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="rocm" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="12" Padding="15" Margin="5">
                                            <StackPanel>
                                                <TextBlock Text="SYCL — Intel" FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="Для совместимой Intel GPU, если установлен подходящий oneAPI/SYCL runtime." Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                <TextBlock Text="Не выбирайте для NVIDIA или AMD. При проблемах используйте Vulkan или CPU." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="10" Margin="0,7,0,12" />
                                                <Button Content="Выбрать SYCL" Command="{Binding SetupSelectAndInstallBackendCommand}" CommandParameter="sycl" Background="{StaticResource BorderStrongBrush}" />
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="{Binding SetupProgressText}" Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" FontSize="11" />
                                                <ProgressBar Value="{Binding SetupProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="Все файлы: SoulExeData" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="18,0,0,0" />
                                        </Grid>
                                    </Border>
                                </Grid>
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitialSetupModelStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="430" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Margin="0,0,20,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="2. Выберите первую модель" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="Это кураторские рекомендации оригинального Models Hub. Выберите карточку — SoulExe скачает рекомендуемый GGUF-квант в SoulExeData." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,7,0,14" />
                                        </StackPanel>
                                        <ListBox Grid.Row="1" ItemsSource="{Binding RecommendedModels}" SelectedItem="{Binding SelectedRecommendedModel}" BorderThickness="0" Background="Transparent" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="10" Margin="0,3">
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock DockPanel.Dock="Right" Text="{Binding OptimalQuant}" Foreground="{StaticResource AccentHoverBrush}" FontSize="10" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,3,0,0" />
                                                            <TextBlock Text="{Binding HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" TextTrimming="CharacterEllipsis" FontSize="10" Margin="0,4,0,0" />
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" CornerRadius="12" Padding="22">
                                        <StackPanel>
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Name}" FontSize="22" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,12" />
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Description}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" />
                                            <Border Background="{StaticResource PanelBrush}" CornerRadius="8" Padding="11" Margin="0,16,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.QuantSummary}" Foreground="{StaticResource AccentHoverBrush}" />
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                                    <TextBlock Text="{Binding RecommendedModelSizeInfo}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,7,0,0" />
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.AuthorNotes}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,5,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <Button Content="{Binding RecommendedModelDownloadText}" Command="{Binding SetupDownloadRecommendedCommand}" Background="{StaticResource AccentSoftBrush}" FontSize="15" Padding="18,11" HorizontalAlignment="Left" Margin="0,20,0,0" />
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                <Button Content="{Binding ModelDownloadPauseResumeText}" Command="{Binding ToggleModelDownloadCommand}" Background="{StaticResource WarningBrush}" />
                                                <Button Content="Отменить загрузку" Command="{Binding CancelModelDownloadCommand}" Background="{StaticResource DangerBrush}" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding SetupProgressText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="2,9,2,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                            <DockPanel Grid.Row="2" LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="После установки движка нажмите «Далее»." Foreground="{StaticResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                <Button DockPanel.Dock="Right" Content="Далее → выбор модели" Command="{Binding NextInitialSetupStepCommand}" Padding="18,11">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitialSetupEngineStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DockPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
