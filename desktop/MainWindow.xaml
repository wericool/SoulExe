<Window x:Class="SoulExe.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" xmlns:vm="clr-namespace:SoulExe.ViewModels" xmlns:ui="clr-namespace:SoulExe" xmlns:controls="clr-namespace:SoulExe.Controls" Title="SoulExe — локальный AI-чат" Width="1440" Height="900" MinWidth="1080" MinHeight="680" Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextPrimaryBrush}" FontFamily="Segoe UI, Inter, sans-serif" WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="8" CornerRadius="0" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Page visibility only — all control styles live in App.xaml -->
        <Style x:Key="PageHome" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsHomePage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageChat" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsChatPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageCharacters" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsCharactersPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageGateway" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGatewayPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageModels" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsModelsPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageMemory" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMemoryPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageMobile" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMobileOptionsTab}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageOptions" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOptionsPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PageSetup" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSetupPage}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="InitialSetupOverlay" TargetType="Grid">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsInitialSetupVisible}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowChromeButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="WindowCloseButton" TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C8334B" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <Border Width="21" Height="21" CornerRadius="7" Background="{StaticResource AccentGradientBrush}" ClipToBounds="True" Effect="{StaticResource AccentGlowEffect}">
                        <Image Source="pack://application:,,,/Assets/SoulExeWindowIcon.png" Stretch="UniformToFill" />
                    </Border>
                    <TextBlock Text="SoulExe" FontSize="13" FontWeight="SemiBold" Margin="9,0,0,0" VerticalAlignment="Center" />
                    <TextBlock Text="локальный AI-чат" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}" Margin="8,1,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Content="−" Click="MinimizeWindowButton_OnClick" Style="{StaticResource WindowChromeButton}" ToolTip="Свернуть" />
                    <Button Click="ToggleMaximizeWindowButton_OnClick">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WindowChromeButton}">
                                <Setter Property="Content" Value="□" />
                                <Setter Property="ToolTip" Value="Развернуть" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType={x:Type Window}}}" Value="Maximized">
                                        <Setter Property="Content" Value="❐" />
                                        <Setter Property="ToolTip" Value="Восстановить размер" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="×" Click="CloseWindowButton_OnClick" Style="{StaticResource WindowCloseButton}" ToolTip="Закрыть" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- ===== NAV RAIL ===== -->
        <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Margin="16,20,16,8">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGradientBrush}" ClipToBounds="True" Effect="{StaticResource AccentGlowEffect}">
                            <Image Source="pack://application:,,,/Assets/SoulExeWindowIcon.png" Stretch="UniformToFill" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="SoulExe" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock Text="local AI studio" FontSize="11" Foreground="{StaticResource TextMutedBrush}" />
                            <TextBlock Text="{Binding BuildInfoDisplay, RelativeSource={RelativeSource AncestorType=Window}}" FontSize="9" Foreground="{StaticResource TextDimBrush}" Margin="0,1,0,0" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="8,8,8,8">
                    <StackPanel>
                        <TextBlock Text="Рабочая область" Style="{StaticResource SectionLabel}" Margin="12,6,12,4" />
                        <Button Content="▢  Разговоры" Style="{StaticResource NavChat}" Command="{Binding NavigateCommand}" CommandParameter="Chat" />
                        <Button Content="◈  Библиотека" Style="{StaticResource NavHome}" Command="{Binding NavigateCommand}" CommandParameter="Home" />
                        <Button Content="◫  Хаб" Style="{StaticResource NavGateway}" Command="{Binding NavigateCommand}" CommandParameter="Gateway" />
                        <TextBlock Text="Система" Style="{StaticResource SectionLabel}" Margin="12,20,12,4" />
                        <Button Content="↗  Быстрый старт" Style="{StaticResource NavSetup}" Command="{Binding NavigateCommand}" CommandParameter="Setup" />
                        <Button Content="◉  Models Hub" Style="{StaticResource NavModels}" Command="{Binding NavigateCommand}" CommandParameter="Models" />
                        <Button Content="☷  Параметры" Style="{StaticResource NavOptions}" Command="{Binding NavigateCommand}" CommandParameter="Options" />
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="12,4,12,16">
                    <Border Background="{StaticResource CardGradientBrush}" CornerRadius="14" Padding="14" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Модель" Style="{StaticResource SectionLabel}" />
                            <ComboBox ItemsSource="{Binding InstalledModels}" SelectedItem="{Binding SelectedInstalledModel}" Margin="0,8,0,0" FontSize="12" ToolTip="Локальные GGUF">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="Нет моделей — скачайте в Hub" FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasInstalledModels}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Button Content="{Binding ModelStartStopText}" Command="{Binding ToggleModelStartStopCommand}" Style="{StaticResource AccentButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" />
                            <DockPanel Margin="0,12,0,0">
                                <Border Width="8" Height="8" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                                    <Setter Property="Background" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                </Border>
                                <TextBlock Text="{Binding ModelState}" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Status}" FontSize="11" Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="4,10,4,0" MaxHeight="40" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </Border>
        <!-- ===== MAIN ===== -->
        <Grid Grid.Row="1" Grid.Column="1" Background="{StaticResource WindowBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- Floating header: title only, no card chrome -->
            <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,18,28,16">
                <DockPanel>
                    <Border DockPanel.Dock="Right" Background="{StaticResource ElevatedBrush}" CornerRadius="999" Padding="12,6" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="7" Height="7" CornerRadius="4" Margin="0,0,8,0" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource TextDimBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsModelRunning}" Value="True">
                                                <Setter Property="Background" Value="#34D399" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                            </Border>
                            <TextBlock Text="{Binding ModelState}" FontSize="12" VerticalAlignment="Center" MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="{Binding PageTitle}" Style="{StaticResource PageHeaderTitle}" />
                        <TextBlock Text="{Binding PageSubtitle}" Style="{StaticResource PageHeaderSubtitle}" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <!-- Pages host -->
            <Grid Grid.Row="1" Margin="24,16,24,20">
                <Grid Style="{StaticResource PageSetup}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="22">
                            <Grid ClipToBounds="True">
                                <!-- ===== Шаг 1: выбор движка ===== -->
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel>
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInitialSetupEngineStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="Шаг 1 / 2" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="Движок llama.cpp" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Text="Движок запускает модель локально. Файлы ставятся только в SoulExeData рядом с программой — без системных установок." Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="13" Margin="0,4,0,10" />
                                        <ListBox ItemsSource="{Binding LlamaBackends}" SelectedItem="{Binding SelectedLlamaBackend}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="3" />
                                                </ItemsPanelTemplate>
                                            </ListBox.ItemsPanel>
                                            <ListBox.ItemContainerStyle>
                                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                                    <Setter Property="Margin" Value="5" />
                                                    <Setter Property="Padding" Value="0" />
                                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                            </ListBox.ItemContainerStyle>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border x:Name="Card" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1.5" CornerRadius="12" Padding="14" MinHeight="164">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="*" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" Background="{StaticResource SuccessBrush}" CornerRadius="6" Padding="8,3" VerticalAlignment="Top">
                                                                    <Border.Style>
                                                                        <Style TargetType="Border">
                                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Border.Style>
                                                                    <TextBlock Text="Уже установлено" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                                                                </Border>
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                            <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" Margin="0,8,0,8" LineHeight="17" />
                                                            <TextBlock Grid.Row="2" Text="{Binding ExampleHardware}" Foreground="{StaticResource AccentHoverBrush}" FontSize="10.5" TextWrapping="Wrap" Margin="0,0,0,8" />
                                                            <TextBlock Grid.Row="3" Text="{Binding Id}" Foreground="{StaticResource TextDimBrush}" FontSize="10" FontFamily="Consolas" />
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                            <Setter TargetName="Card" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter TargetName="Card" Property="BorderThickness" Value="2.5" />
                                                            <Setter TargetName="Card" Property="Background" Value="#2A2440" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Text="Выбрано" Style="{StaticResource SectionLabel}" />
                                                    <TextBlock Text="{Binding SelectedLlamaBackend.DisplayName}" FontSize="16" FontWeight="SemiBold" Margin="0,4,0,0" />
                                                    <TextBlock Text="{Binding SelectedBackendInstallState}" Foreground="{StaticResource AccentHoverBrush}" FontSize="12" Margin="0,3,0,0" />
                                                    <TextBlock Text="{Binding SelectedBackendDescription}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,6,0,0" />
                                                    <TextBlock Text="После установки нажмите «Далее → выбор модели» внизу." Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,8,0,0" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0" MinWidth="200">
                                                    <Button Content="Установить движок" Command="{Binding SetupInstallEngineCommand}" Style="{StaticResource AccentButton}" HorizontalAlignment="Stretch" Padding="16,12" />
                                                    <TextBlock Text="Прогресс установки" Style="{StaticResource SectionLabel}" Margin="0,10,0,3" />
                                                    <TextBlock Text="{Binding SetupProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,4" />
                                                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding SetupProgressPercent, Mode=OneWay}" Height="7" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                                <!-- ===== Шаг 2: рекомендованные модели ===== -->
                                <Grid>
                                    <Grid.Style>
                                        <Style TargetType="Grid">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsInitialSetupModelStep}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Grid.Style>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Margin="0,0,0,6">
                                            <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoftBrush}" CornerRadius="8" Padding="10,4" VerticalAlignment="Center">
                                                <TextBlock Text="Шаг 2 / 2" FontSize="11" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Text="Рекомендации" FontSize="22" FontWeight="SemiBold" Margin="14,0,0,0" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                            <TextBlock Text="{Binding RecommendedModels.Count, StringFormat=Всего рекомендаций: {0}}" Foreground="{StaticResource AccentHoverBrush}" FontSize="11" />
                                            <TextBlock DockPanel.Dock="Right" Text="Выберите модель из полного списка" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                        </DockPanel>
                                        <ListBox Grid.Row="2" ItemsSource="{Binding RecommendedModels}" SelectedItem="{Binding SelectedRecommendedModel}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" ScrollViewer.CanContentScroll="True">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,3">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto" />
                                                                <RowDefinition Height="Auto" />
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                            <Border Grid.Column="1" Background="{StaticResource ElevatedBrush}" CornerRadius="5" Padding="7,2" Margin="10,0,0,0">
                                                                <TextBlock Text="{Binding OptimalQuant}" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                            </Border>
                                                            <WrapPanel Grid.Row="1" Margin="0,5,0,0">
                                                                <TextBlock Text="{Binding Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                                                                <TextBlock Text="{Binding Downloads, StringFormat=  •  Загрузки: {0:N0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" />
                                                                <TextBlock Text="{Binding HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" FontSize="10" Margin="12,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="390" />
                                                            </WrapPanel>
                                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource SuccessBrush}" CornerRadius="5" Padding="7,2" Margin="10,5,0,0">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="Скачано" Foreground="{StaticResource SuccessTextBrush}" FontSize="9" FontWeight="Bold" />
                                                            </Border>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                    <Border Grid.Column="2" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                        <StackPanel>
                                            <TextBlock Text="Выбранная модель" Style="{StaticResource SectionLabel}" />
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Author, StringFormat=Автор: {0}}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,5,0,0" />
                                            <TextBlock Text="{Binding SelectedRecommendedModel.Description}" TextWrapping="Wrap" Foreground="{StaticResource TextPrimaryBrush}" FontSize="12.5" Margin="0,12,0,0" LineHeight="19" />
                                            <Border Background="{StaticResource CardGradientBrush}" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.QuantSummary}" Foreground="{StaticResource AccentHoverBrush}" TextWrapping="Wrap" FontSize="12" />
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.HardwareSummary}" Foreground="{StaticResource SuccessTextBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding SelectedRecommendedModel.BeginnerHint}" Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" FontSize="12" Margin="0,6,0,0" />
                                                    <TextBlock Text="{Binding RecommendedModelSizeInfo}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,6,0,0" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Прогресс скачивания" Style="{StaticResource SectionLabel}" Margin="0,16,0,3" />
                                            <TextBlock Text="{Binding SetupProgressText}" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,0,0,4" />
                                            <ProgressBar Minimum="0" Maximum="100" Value="{Binding SetupModelDownloadPercent, Mode=OneWay}" Height="7" />
                                            <Button Content="Скачать модель" Command="{Binding SetupDownloadRecommendedCommand}" Style="{StaticResource AccentButton}" Margin="0,14,0,0" HorizontalAlignment="Stretch" Padding="14,12" />
                                            <Button Content="{Binding ModelDownloadPauseResumeText}" Command="{Binding ToggleModelDownloadCommand}" Style="{StaticResource CompactButton}" Background="{StaticResource WarningBrush}" Margin="0,8,0,0" ToolTip="Во время загрузки — пауза; после паузы — продолжить" />
                                            <Button Content="Запустить и открыть чат" Command="{Binding SetupStartChatCommand}" Style="{StaticResource SuccessButton}" Margin="0,10,0,0" HorizontalAlignment="Stretch" Padding="14,12" />
                                            <TextBlock Text="{Binding ModelDownloadStatus}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" FontSize="11" Margin="0,10,0,0" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>
                        <!-- Нижняя панель: только Далее после установки движка -->
                        <Border Grid.Row="1" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,12,0,0">
                            <DockPanel LastChildFill="False">
                                <TextBlock DockPanel.Dock="Left" Text="{Binding SelectedBackendInstallState, StringFormat=Движок: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
