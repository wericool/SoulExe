                                    <TextBlock Text="Создайте образ пользователя: имя, роль, характер, биографию и важные постоянные факты." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="390" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Personas}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Width="236" Height="280" Margin="0,0,16,16">
                                            <Border x:Name="PersonaCard" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
