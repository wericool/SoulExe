                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Каталог" Command="{Binding SetModelsHubTabCommand}" CommandParameter="Catalog" Margin="0" Padding="14,8">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                <Setter Property="Background" Value="Transparent" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsModelsCatalogTab}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Рекомендации" Command="{Binding SetModelsHubTabCommand}" CommandParameter="Recommendations" Margin="0" Padding="14,8">
