                                                    <Border Background="{StaticResource ElevatedBrush}">
                                                        <TextBlock Text="{Binding Initials}" FontSize="46" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Image Source="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                    <Border VerticalAlignment="Bottom" Height="142">
                                                        <Border.Background>
                                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                                <GradientStop Color="#00050507" Offset="0" />
                                                                <GradientStop Color="#F1080A13" Offset="1" />
                                                            </LinearGradientBrush>
                                                        </Border.Background>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Bottom" Margin="15,0,15,16">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="17" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Description}" Foreground="#D6DAEA" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" Margin="0,4,0,0" />
                                                        <TextBlock Text="Персона пользователя" Foreground="{StaticResource AccentHoverBrush}" FontSize="10" Margin="0,7,0,0" />
                                                    </StackPanel>
                                                    <Border x:Name="CardActions" Background="#DD0A0D19" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <Grid>
                                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                                <Button Content="✎" Command="{Binding DataContext.OpenPersonaEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CircleIconButton}" ToolTip="Редактировать персону" />
                                                                <Button Content="✕" Command="{Binding DataContext.ConfirmDeletePersonaCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CircleIconButtonDanger}" Margin="8,0,0,0" ToolTip="Удалить персону" />
                                                            </StackPanel>
                                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                                <TextBlock Text="Контекст пользователя" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,12" HorizontalAlignment="Center" />
                                                                <Button Content="✎  Редактор" Command="{Binding DataContext.OpenPersonaEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource AccentButton}" Padding="15,9" ToolTip="Открыть редактор персоны" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Grid>
