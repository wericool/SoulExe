                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Штраф за частоту" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Штраф за частоту (Frequency Penalty). Штрафует слова в зависимости от того, сколько раз они уже встречались в тексте. Заставляет ИИ использовать богатый словарный запас и искать синонимы, а не повторять одни и те же прилагательные. Слишком высокие значения ломают грамматику. Оптимально: 0.0 - 0.5." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding LlamaOptions.FrequencyPenalty}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.FrequencyPenalty}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Штраф за присутствие" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Штраф за присутствие (Presence Penalty). Накладывает штраф на слово, если оно встретилось хотя бы один раз. В отличие от штрафа за частоту, это заставляет ИИ менять тему разговора и вводить новые концепции, не давая диалогу застрять в одной точке. При высоких значениях ИИ будет хаотично прыгать по темам. Оптимально: 0.0 - 0.4." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="2" SmallChange="0.05" Value="{Binding LlamaOptions.PresencePenalty}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.PresencePenalty}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <!-- Оборудование. -->
                                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Оборудование" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="Движок" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border DockPanel.Dock="Right" Background="{StaticResource BorderStrongBrush}" Height="1" Width="435" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Команда запуска сервера" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Фактическая команда, с которой SoulExe запускает локальный llama-server. Это диагностическое поле, а не сетевой облачный сервис." />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Text="{Binding ModelLaunchCommand, Mode=OneWay}" IsReadOnly="True" ToolTip="Фактическая команда запуска llama.cpp" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Вычислительный движок" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Выбирает сборку llama.cpp: CPU для любого ПК; CUDA для NVIDIA; Vulkan для совместимых GPU; ROCm для AMD; SYCL для Intel." />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" ItemsSource="{Binding LlamaBackends}" SelectedItem="{Binding SelectedLlamaBackend}" DisplayMemberPath="DisplayName" />
                                                        <Button Grid.Column="2" Content="Установить" Command="{Binding InstallEngineCommand}" Background="{StaticResource BorderStrongBrush}" />
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Тип KV-кэша" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Квантизируйте Context Cache, чтобы сэкономить значительный объем видеопамяти при работе с длинными контекстами." />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding LlamaOptions.KvCacheType}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="f16" />
                                                            <ComboBoxItem Content="q8_0" />
                                                            <ComboBoxItem Content="q4_1" />
                                                            <ComboBoxItem Content="q4_0" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <WrapPanel Margin="170,10,0,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                            <CheckBox Content="MLock" IsChecked="{Binding LlamaOptions.UseMlock}" />
                                                            <ui:HelpHint Hint="MLock (Блокировка памяти). Эта функция предотвращает выгрузку языковой модели из оперативной памяти (RAM) в файл подкачки на диске. Когда опция включена, модель остается полностью загруженной в памяти, что гарантирует максимально быстрый отклик без микрофризов при генерации каждого нового сообщения. Рекомендуется включать только при наличии достаточного объема ОЗУ, так как эта память будет постоянно заблокирована системой. На ПК с малым объемом памяти лучше оставить отключенной." />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                                                            <CheckBox Content="Использовать MMAP" IsChecked="{Binding LlamaOptions.UseMmap}" />
                                                            <ui:HelpHint Hint="Режим No MMAP (Прямая загрузка в ОЗУ). По умолчанию модели загружаются с использованием отображения в память (mmap), что означает, что части модели считываются с диска по требованию прямо во время генерации. Включение этой опции заставляет систему полностью загружать модель в оперативную память (RAM) заранее. Это немного увеличивает время начальной загрузки и потребление RAM, но предотвращает микрозависания и задержки во время генерации текста. Настоятельно рекомендуется, если у вас достаточно системной памяти." />
                                                        </StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox Content="Flash Attention" IsChecked="{Binding LlamaOptions.FlashAttention}" />
                                                            <ui:HelpHint Hint="Flash Attention. Новейшая технология, ускоряющая генерацию и снижающая потребление VRAM при обработке длинных чатов. Оптимизирует вычисления внутри нейросети на больших размерах контекста (4K, 8K и выше). Настоятельно рекомендуется всегда держать включенным." />
                                                        </StackPanel>
                                                    </WrapPanel>
                                                    <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="225" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox Content="Режим рассуждений" IsChecked="{Binding LlamaOptions.ReasoningMode}" FontWeight="SemiBold" />
                                                                <ui:HelpHint Hint="Режим размышлений (Thinking Mode). Создан для мыслящих моделей вроде DeepSeek-R1 или QwQ, которые генерируют внутренние рассуждения перед ответом. При включении интерфейс прячет теги &lt;think&gt; в красивый блок и запрещает голосовому движку (TTS) читать мысли вслух. Оставьте выключенным для обычных моделей (Llama-3, Mistral, обычный Qwen)." />
                                                            </StackPanel>
                                                            <StackPanel Grid.Column="1" IsEnabled="{Binding LlamaOptions.ReasoningMode}">
                                                                <TextBlock Text="При включении настройте бюджет рассуждений выше." Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                    <DockPanel Margin="0,20,0,8">
                                                        <TextBlock Text="Производительность" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border DockPanel.Dock="Right" Background="{StaticResource BorderStrongBrush}" Height="1" Width="360" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Слои в GPU" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Загрузка слоев в GPU. Позволяет контролировать, какая часть модели обрабатывается видеокартой (VRAM), а какая — процессором (RAM). Чем больше слоев в видеокарте, тем быстрее генерация, но тем выше требования к памяти. Особенно полезно для больших моделей (от 13B). Если у вас мощная видеокарта, выкручивайте на максимум." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LlamaOptions.GpuLayers}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.GpuLayers}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="MoE-слои на CPU" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="0 = Отключено. Количество слоев «Mixture of Experts» (MoE), размещаемых в оперативной памяти (CPU RAM). Крайне важно для работы с моделями архитектуры MoE." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding LlamaOptions.CpuMoeLayers}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.CpuMoeLayers}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Размер контекста" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Контекстное окно. Это максимальное количество токенов, которое модель может обработать за раз (её рабочая память). Включает историю чата, авторские заметки и записи из lorebook. Большее контекстное окно позволяет персонажу помнить больше, но значительно увеличивает потребление VRAM. Уменьшите это значение на слабых ПК. Для долгосрочной памяти лучше держите включённым модуль «Soul Memory», а не выкручивайте контекст на максимум." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="2048" Maximum="131072" Ticks="2048,4096,8192,16384,32768,65536,131072" IsSnapToTickEnabled="True" TickPlacement="BottomRight" AutoToolTipPlacement="BottomRight" Value="{Binding LlamaOptions.ContextSize}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.ContextSize}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Размер пакета prompt" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Количество токенов, обрабатываемых одновременно при оценке промпта. Значение 512 является безопасным. Чем выше значение, тем быстрее загрузка и тем больше требуется VRAM." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="8192" LargeChange="128" Value="{Binding LlamaOptions.BatchSize}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.BatchSize}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <Grid Margin="0,9,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Потоки CPU" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="0 = Автоматически. Укажите количество физических ядер процессора для обеспечения оптимальной скорости инференса на процессоре." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="64" Value="{Binding LlamaOptions.CpuThreads}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.CpuThreads}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                    </Grid>
                                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,4">
                                                        <TextBlock Text="Пользовательские аргументы llama.cpp" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" />
                                                        <ui:HelpHint Hint="Пользовательские аргументы. Позволяет передавать дополнительные аргументы командной строки напрямую локальному LLM-серверу (llama.cpp). Это предназначено для опытных пользователей, которые хотят точно настроить специфические параметры движка (например, масштабирование RoPE или параметры кэширования), не представленные в графическом интерфейсе. Используйте с осторожностью. Неверные флаги могут привести к сбою сервера или переопределить настройки интерфейса. Пример: --rope-freq-base 10000." />
                                                    </StackPanel>
                                                    <TextBox Text="{Binding LlamaOptions.ExtraArguments}" />
                                                </StackPanel>
                                            </Border>
                                            <!-- Prompt и расширенный sampling. -->
                                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Margin="0,0,0,14">
                                                <StackPanel>
                                                    <TextBlock Text="Промпт" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                    <DockPanel Margin="0,18,0,8">
                                                        <TextBlock Text="Шаблон и стоп-строки" Foreground="{StaticResource AccentHoverBrush}" Style="{StaticResource SectionLabel}" />
                                                        <Border DockPanel.Dock="Right" Background="{StaticResource BorderStrongBrush}" Height="1" Width="365" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Шаблон чата" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Шаблон чата (Chat Template). Определяет, в каком формате ваш текст отправляется нейросети. Разные ИИ обучены на разных форматах. Если шаблон не совпадает с моделью, бот начнет галлюцинировать или выводить спецсимволы (например, &lt;|im_end|&gt;). Auto берет шаблон прямо из GGUF файла. Если модель ведет себя странно, выберите вручную ChatML или Llama-3." />
                                                        </StackPanel>
                                                        <ComboBox Grid.Column="1" SelectedValue="{Binding LlamaOptions.ChatTemplate}" SelectedValuePath="Content">
                                                            <ComboBoxItem Content="auto" />
                                                            <ComboBoxItem Content="chatml" />
                                                            <ComboBoxItem Content="llama-3" />
                                                            <ComboBoxItem Content="deepseek" />
                                                            <ComboBoxItem Content="qwen" />
                                                            <ComboBoxItem Content="mistral" />
                                                            <ComboBoxItem Content="alpaca" />
                                                        </ComboBox>
                                                    </Grid>
                                                    <Grid Margin="0,10,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Стоп-строки" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Стоп-строки (Stop Strings). Список слов или тегов, при появлении которых ИИ немедленно прекращает генерацию. Это важнейший инструмент, чтобы запретить ИИ говорить или действовать за вас (например, генерировать User: и отвечать на свои же вопросы). Перечисляйте через запятую. Пример: User:, &lt;/s&gt;, &lt;|eot_id|&gt;." />
                                                        </StackPanel>
                                                        <TextBox Grid.Column="1" Text="{Binding LlamaOptions.StopStrings}" ToolTip="Разделяйте значения символом | или новой строкой" />
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <CheckBox Content="Включить расширенный сэмплинг LLM" IsChecked="{Binding LlamaOptions.EnableAdvancedSampling}" FontSize="17" FontWeight="SemiBold" />
                                                            <ui:HelpHint Hint="Если эта опция отключена, используются стандартные настройки генерации с первой панели. Расширенные настройки игнорируются." />
                                                        </StackPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="Продвинутый sampling" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <Grid IsEnabled="{Binding LlamaOptions.EnableAdvancedSampling}" Margin="0,17,0,0">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="170" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="112" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Min-P" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Min-P (Умное отсечение). Новый золотой стандарт RolePlay. Динамически отсекает мусорные слова на основе вероятности самого лучшего слова. Если ИИ уверен в ответе, Min-P безжалостно режет бред. Если ИИ нужно проявить фантазию, барьер снижается, впуская красивые синонимы. Замена Top-P. Установите Top-P на 1.0, а Min-P на 0.05 - 0.10 для идеальной логики при высокой Температуре." />
                                                        </StackPanel>
                                                        <Slider Grid.Column="1" Minimum="0" Maximum="1" SmallChange="0.01" Value="{Binding LlamaOptions.MinP}" />
                                                        <TextBox Grid.Column="2" Text="{Binding LlamaOptions.MinP}" TextAlignment="Center" Padding="6,3" MinWidth="100" />
                                                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,9,0,0">
                                                            <TextBlock Text="Мин. динамич. темп." VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Динамическая Температура. Вместо фиксированного значения, температура плавает между Мин. и Макс. границами в зависимости от уверенности ИИ. Описывая факты, температура падает для логики. Описывая эмоции, температура взлетает для креатива." />
                                                        </StackPanel>
                                                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding LlamaOptions.DynamicTemperatureMin}" Margin="0,9,0,0" />
                                                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding LlamaOptions.DynamicTemperatureMin}" TextAlignment="Center" Margin="0,9,0,0" />
                                                        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,9,0,0">
                                                            <TextBlock Text="Макс. динамич. темп." VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="Динамическая Температура. Вместо фиксированного значения, температура плавает между Мин. и Макс. границами в зависимости от уверенности ИИ. Описывая факты, температура падает для логики. Описывая эмоции, температура взлетает для креатива." />
                                                        </StackPanel>
                                                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="2" Value="{Binding LlamaOptions.DynamicTemperatureMax}" Margin="0,9,0,0" />
                                                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding LlamaOptions.DynamicTemperatureMax}" TextAlignment="Center" Margin="0,9,0,0" />
                                                        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,9,0,0">
                                                            <TextBlock Text="Вероятность XTC" VerticalAlignment="Center" />
                                                            <ui:HelpHint Hint="XTC (Удаление банальностей). Революция для RP. Принудительно удаляет самые очевидные и клишированные слова из вариантов выбора ИИ. Устали от фраз «мурашки пробежали по спине» или «хищная ухмылка»? XTC заставит модель искать уникальные, литературные альтернативы. Вероятность: шанс срабатывания алгоритма (оптимально 0.3 - 0.5)." />
                                                        </StackPanel>
                                                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding LlamaOptions.XtcProbability}" Margin="0,9,0,0" />
                                                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding LlamaOptions.XtcProbability}" TextAlignment="Center" Margin="0,9,0,0" />
