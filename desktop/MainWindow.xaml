                                                </Border>
                                                <Image Source="{Binding Character.AvatarPath}" Stretch="UniformToFill" />
                                                <Border VerticalAlignment="Bottom" Height="118">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#00050507" Offset="0" />
                                                            <GradientStop Color="#F1080A13" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                                <StackPanel VerticalAlignment="Bottom" Margin="15,0,15,16">
                                                    <TextBlock Text="{Binding Character.Name}" FontWeight="SemiBold" FontSize="17" Foreground="White" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Character.Title}" Foreground="#D6DAEA" FontSize="11.5" TextTrimming="CharacterEllipsis" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <!-- Никаких локальных Opacity: стиль гарантирует появление панели при наведении на всю карточку. -->
                                                <Border x:Name="CardActions" Background="#DD0A0D19" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="10" Padding="12">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border, AncestorLevel=1}}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                                            <Button Content="✎" Command="{Binding DataContext.OpenCharacterEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource CircleIconButton}" ToolTip="Редактировать персонажа" />
                                                            <Button Content="✕" Command="{Binding DataContext.ConfirmDeleteCharacterCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource CircleIconButtonDanger}" Margin="8,0,0,0" ToolTip="Удалить персонажа" />
                                                        </StackPanel>
                                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Character.Name}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                                            <TextBlock Text="Открыть новый диалог" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,12" HorizontalAlignment="Center" />
                                                            <Button Content="▶  Новый чат" Command="{Binding DataContext.OpenCharacterChatCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Character}" Style="{StaticResource AccentButton}" Padding="15,9" ToolTip="Открыть чат с персонажем" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <!-- Последняя карточка добавления в тех же размерах и прямоугольном стиле. -->
                                        <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1.5" CornerRadius="10" Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAddCharacter}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                                                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                                            <Setter Property="Effect" Value="{StaticResource AccentGlowEffect}" />
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Border.InputBindings>
                                                <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.OpenCharacterCreationDialogCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            </Border.InputBindings>
                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                <Border Width="54" Height="54" CornerRadius="27" Background="{StaticResource AccentSoftBrush}">
                                                    <TextBlock Text="＋" FontSize="29" Foreground="{StaticResource AccentHoverBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="Новый персонаж" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold" FontSize="14" Margin="0,13,0,0" HorizontalAlignment="Center" />
                                                <TextBlock Text="Создать карточку" Foreground="{StaticResource TextMutedBrush}" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryLoreTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="＋ Новый лорбук" Command="{Binding AddLorebookCommand}" Style="{StaticResource AccentButton}" />
                                <StackPanel>
                                    <TextBlock Text="Загруженные лоры" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Миры, правила, места и события, доступные для привязки к персонажам." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Lorebooks.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="◫" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
                                    <TextBlock Text="Здесь появятся ваши лорбуки" FontWeight="SemiBold" Margin="0,10,0,0" HorizontalAlignment="Center" />
                                    <TextBlock Text="Импортируйте лорбук из ХАБа или создайте новый." Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,5,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <ItemsControl ItemsSource="{Binding Lorebooks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="300" Height="182" Margin="0,0,14,14" Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="16">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <DockPanel>
                                                    <Button DockPanel.Dock="Right" Content="✕" Command="{Binding DataContext.DeleteLorebookCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource CircleIconButtonDanger}" Width="26" Height="26" FontSize="11" Padding="0" ToolTip="Удалить лорбук" />
                                                    <Border DockPanel.Dock="Left" Width="34" Height="34" CornerRadius="8" Background="{StaticResource AccentSoftBrush}" Margin="0,0,10,0">
                                                        <TextBlock Text="◫" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource AccentHoverBrush}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </DockPanel>
                                                <TextBlock Grid.Row="1" Text="{Binding Description}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="52" Margin="0,12,0,0" />
                                                <DockPanel Grid.Row="2" LastChildFill="False">
                                                    <TextBlock DockPanel.Dock="Left" Text="{Binding Entries.Count, StringFormat=Записей: {0}}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="126" />
                                                    <Button DockPanel.Dock="Right" Content="Редактор" Command="{Binding DataContext.OpenLibraryLoreEditorCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" Padding="10,5" FontSize="10" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsLibraryPersonasTab}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel>
                            <DockPanel Margin="0,0,0,16">
                                <Button DockPanel.Dock="Right" Content="＋ Новая персона" Command="{Binding AddPersonaCommand}" Style="{StaticResource AccentButton}" />
                                <StackPanel>
                                    <TextBlock Text="Персоны пользователя" FontSize="16" FontWeight="SemiBold" />
                                    <TextBlock Text="Сохраните разные образы пользователя и назначайте их отдельным персонажам. Персона добавляется в системный контекст до истории чата." Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </DockPanel>
                            <Border Background="{StaticResource CardGradientBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="18">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Personas.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center" Margin="0,24">
                                    <TextBlock Text="◌" FontSize="28" HorizontalAlignment="Center" Foreground="{StaticResource TextMutedBrush}" />
