                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInitialSetupModelStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Content="Далее → выбор модели" Command="{Binding NextInitialSetupStepCommand}" Padding="18,11">
