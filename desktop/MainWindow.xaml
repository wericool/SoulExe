                                            <Style TargetType="Button" BasedOn="{StaticResource SuccessButton}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsInitialSetupEngineStep}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
                <!-- Главная: единый список персонажей и последняя карточка добавления. -->
                <Grid Style="{StaticResource PageHome}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="1" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <ComboBox ItemsSource="{Binding HomeCharacterSortOptions}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" SelectedValue="{Binding HomeCharacterSortMode}" Width="180" FontSize="12">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource LibrarySortCombo}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </DockPanel>
                    <DockPanel Grid.Row="0" Margin="0,0,0,12" LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Персонажи" Command="{Binding SelectLibraryTabCommand}" CommandParameter="characters" Padding="16,9" Margin="0,0,4,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionsTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Лор" Command="{Binding SelectLibraryTabCommand}" CommandParameter="lore" Padding="16,9">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionsTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryLoreTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button Content="Персоны" Command="{Binding SelectLibraryTabCommand}" CommandParameter="personas" Padding="16,9" Margin="4,0,0,0">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource OptionsTabButton}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLibraryPersonasTab}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource AccentGradientBrush}" />
                                                <Setter Property="Foreground" Value="White" />
                                                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLibraryCharactersTab}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock Text="Импорт" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <Button Content="Card V2" Command="{Binding ImportCharacterCommand}" Style="{StaticResource GhostButton}" Padding="11,7" Margin="0,0,7,0" ToolTip="Импорт Character Card V2 в формате PNG или JSON" />
                            <Button Content="Soul-of-Waifu" Command="{Binding ImportSoulOfWaifuCommand}" Style="{StaticResource GhostButton}" Padding="11,7" ToolTip="Импорт персонажей и данных из старой установки Soul-of-Waifu" />
                        </StackPanel>
                    </DockPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
