<UserControl x:Class="SoulExe.Controls.ConversationComposerView" x:Name="Root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Border>
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ConversationComposerBar}"><Setter Property="Visibility" Value="Visible"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=Root}" Value="Group"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ComposerAuthors}" SelectedItem="{Binding ComposerAuthor}" DisplayMemberPath="DisplayName" ToolTip="От чьего имени отправить сообщение"/>
                <Border Grid.Column="2" Style="{StaticResource ConversationComposerInput}"><TextBox Style="{StaticResource ChatComposerTextBox}" Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter — отправить; Shift+Enter — новая строка" PreviewKeyDown="PersonalDraft_OnPreviewKeyDown" AutomationProperties.Name="Текст личного сообщения" AutomationProperties.HelpText="Enter отправляет сообщение. Shift+Enter вставляет новую строку." /></Border>
                <Button Grid.Column="4" Content="Продолжить" Command="{Binding ContinueChatCommand}" Style="{StaticResource ChatComposerButton}" ToolTip="Попросить персонажа продолжить ответ"/>
                <Button Grid.Column="6" Content="➤" Command="{Binding SendCommand}" Style="{StaticResource ChatComposerSendButton}" AutomationProperties.Name="Отправить сообщение" AutomationProperties.HelpText="Отправляет личное сообщение. Также можно нажать Enter в поле ввода." ToolTip="Отправить (Enter)"/>
            </Grid>
        </Border>
        <Border>
            <Border.Style><Style TargetType="Border" BasedOn="{StaticResource ConversationComposerBar}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Tag, ElementName=Root}" Value="Group"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <ComboBox ItemsSource="{Binding ComposerAuthors}" SelectedItem="{Binding ComposerAuthor}" DisplayMemberPath="DisplayName" ToolTip="От чьего имени отправить сообщение"/>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource ConversationComposerInput}"><TextBox Style="{StaticResource ChatComposerTextBox}" Text="{Binding GroupDraft, UpdateSourceTrigger=PropertyChanged}" ToolTip="Enter и Shift+Enter — новая строка; Ctrl+Enter — отправить" PreviewKeyDown="GroupDraft_OnPreviewKeyDown" AutomationProperties.Name="Текст реплики группового разговора" AutomationProperties.HelpText="Enter и Shift+Enter вставляют новую строку. Ctrl+Enter отправляет реплику." /></Border>
                    <TextBlock Text="Ctrl+Enter — отправить; Enter — новая строка" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="4,4,0,0" />
                </StackPanel>
                <Button Grid.Column="4" Content="{Binding SceneStartPauseText}" Command="{Binding ToggleSceneStartPauseCommand}" Style="{StaticResource ChatComposerAccentButton}"/>
                <Button Grid.Column="6" Content="Следующая реплика" Command="{Binding NextSceneTurnCommand}" Style="{StaticResource ChatComposerButton}"/>
                <Button Grid.Column="8" Content="Отправить" Command="{Binding SendGroupMessageCommand}" Style="{StaticResource ChatComposerSendButton}" AutomationProperties.Name="Отправить реплику группового разговора" AutomationProperties.HelpText="Отправляет реплику группового разговора. Также можно нажать Ctrl+Enter в поле ввода." ToolTip="Отправить (Ctrl+Enter)"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>
