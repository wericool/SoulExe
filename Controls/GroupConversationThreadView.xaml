<UserControl x:Class="SoulExe.Controls.GroupConversationThreadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:views="clr-namespace:SoulExe.Views"
             xmlns:controls="clr-namespace:SoulExe.Controls">
    <UserControl.Resources>
        <ui:AvatarAwareChatSurfaceBrushConverter x:Key="AvatarAwareChatSurfaceBrushConverter" />
        <Style x:Key="SceneHeaderAction" TargetType="Button" BasedOn="{StaticResource CircleIconButton}"><Setter Property="Width" Value="34" /><Setter Property="Height" Value="34" /></Style>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Border.Background><MultiBinding Converter="{StaticResource AvatarAwareChatSurfaceBrushConverter}"><Binding Path="ChatAppearance.UseCharacterAvatarBackground" /><Binding Path="IsSceneChatActive" /><Binding Path="SelectedCharacter.AvatarPath" /><Binding Path="SelectedSceneCharacterA.AvatarPath" /><Binding Path="ChatAppearance.ChatBackgroundColor" /></MultiBinding></Border.Background>
        <Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSceneChatActive}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,2">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" MinWidth="0">
                        <Grid Width="58" Height="40"><Ellipse Width="40" Height="40" HorizontalAlignment="Left" Fill="{StaticResource AccentSoftBrush}" /><TextBlock Text="{Binding SelectedSceneCharacterA.Initials}" Width="40" FontSize="11" FontWeight="Bold" Foreground="White" TextAlignment="Center" VerticalAlignment="Center" /><Ellipse Width="40" Height="40" HorizontalAlignment="Left" IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding SelectedSceneCharacterA.AvatarPath}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse><Ellipse Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="{StaticResource AccentSoftBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" /><TextBlock Text="{Binding SelectedSceneCharacterB.Initials}" Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom" Padding="0,7,0,0" FontSize="8" FontWeight="Bold" Foreground="White" TextAlignment="Center" /><Ellipse Width="27" Height="27" HorizontalAlignment="Right" VerticalAlignment="Bottom" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding SelectedSceneCharacterB.AvatarPath}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse></Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" MinWidth="0"><TextBlock Text="{Binding SceneHeaderTitle}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SceneParticipantNames}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="☰" Command="{x:Static views:ChatWorkspaceView.ShowConversationListCommand}" Style="{StaticResource SceneHeaderAction}" ToolTip="Диалоги" AutomationProperties.Name="Открыть список диалогов" Margin="0,0,6,0" /><Button Content="ⓘ" Command="{x:Static views:ChatWorkspaceView.ShowConversationDetailsCommand}" Style="{StaticResource SceneHeaderAction}" ToolTip="Информация" AutomationProperties.Name="Открыть информацию о разговоре" Margin="0,0,6,0" /><Button Content="⌕" Command="{Binding ToggleSceneMessageSearchCommand}" Style="{StaticResource SceneHeaderAction}" ToolTip="Поиск" AutomationProperties.Name="Открыть поиск по репликам" Margin="0,0,6,0" /><Button Content="…" Style="{StaticResource SceneHeaderAction}" ToolTip="Действия" AutomationProperties.Name="Действия с разговором" Click="MessageMenuButton_OnClick" Tag="{Binding}"><Button.ContextMenu><ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom"><MenuItem Header="{Binding PlacementTarget.Tag.SelectedConversationItem.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleConversationPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="✎  Переименовать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><Separator /><MenuItem Header="🗑  Удалить разговор" Style="{StaticResource ChatActionMenuItem}" Foreground="{StaticResource DangerHoverBrush}" Command="{Binding PlacementTarget.Tag.DeleteConversationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedConversationItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></Button.ContextMenu></Button></StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="SceneMessagesList" ItemsSource="{Binding SceneMessages}" Style="{StaticResource ConversationMessageList}" Padding="28,18,28,18" ScrollViewer.ScrollChanged="SceneMessagesScroll_OnScrollChanged" PreviewMouseWheel="SceneMessages_OnPreviewMouseWheel" PreviewKeyDown="SceneMessages_OnPreviewKeyDown" PreviewMouseDown="SceneMessages_OnPreviewMouseDown" PreviewMouseUp="SceneMessages_OnPreviewMouseUp">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ConversationMessageListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SceneMessageViewModel}">
                            <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="620" Margin="0,5" Padding="14,10" CornerRadius="14" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                <StackPanel>
                                    <StackPanel x:Name="SpeakerRow" Orientation="Horizontal" Margin="0,0,0,7"><Border x:Name="Avatar" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0"><Grid><TextBlock Text="{Binding SpeakerInitials}" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse></Grid></Border><TextBlock x:Name="Speaker" Text="{Binding SpeakerName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" /></StackPanel>
                                    <DockPanel><TextBlock x:Name="Time" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1" /><ui:SelectableFormattedChatBox x:Name="SceneText" ContentText="{Binding Content}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" /></DockPanel>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True"><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /><Setter TargetName="Bubble" Property="BorderThickness" Value="2" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsFirstCharacter}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Left" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsSecondCharacter}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsUserParticipant}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" /></DataTrigger>
                                <DataTrigger Binding="{Binding IsDirector}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource BorderStrongBrush}" /><Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" /></DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Margin="24"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyState}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SceneMessages.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center"><TextBlock Text="Сцена пока не началась" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Добавьте свою реплику или запустите сцену кнопкой Play." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border>
                <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="12,8" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="28,0,28,16"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsSceneTyping}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="Персонаж печатает…" FontSize="11" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" /></Border>
                <Button x:Name="NewMessagesButton" Content="↓  К последнему" Click="NewMessagesButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,8" Style="{StaticResource AccentButton}" Visibility="Collapsed" AutomationProperties.Name="Перейти к последнему сообщению" />
                <Button Content="Загрузить предыдущие сообщения" Command="{Binding LoadOlderSceneMessagesCommand}" Click="LoadOlderMessagesButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasOlderSceneMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid>
            <controls:ConversationComposerView Grid.Row="2" Tag="Group" />
        </Grid>
    </Border>
</UserControl>
