<UserControl x:Class="SoulExe.Controls.ConversationThreadView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:controls="clr-namespace:SoulExe.Controls">
    <UserControl.Resources>
        <DataTemplate x:Key="PersonalConversationThreadTemplate">
            <controls:PersonalConversationThreadView />
        </DataTemplate>
        <DataTemplate x:Key="GroupConversationThreadTemplate">
            <controls:GroupConversationThreadView />
        </DataTemplate>
        <Style x:Key="ActiveConversationThreadContent" TargetType="ContentControl">
            <Setter Property="Content" Value="{Binding}" />
            <Setter Property="ContentTemplate" Value="{StaticResource PersonalConversationThreadTemplate}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                    <Setter Property="ContentTemplate" Value="{StaticResource GroupConversationThreadTemplate}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ContentControl x:Name="ActiveConversationThread" Style="{StaticResource ActiveConversationThreadContent}" />
</UserControl>
