<UserControl x:Class="SoulExe.Controls.GroupConversationSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoulExe">
    <UserControl.Resources><ui:AvatarAwareChatSurfaceBrushConverter x:Key="AvatarAwareChatSurfaceBrushConverter" /></UserControl.Resources>
<Border Grid.Column="4" Panel.ZIndex="20" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
    <Border.Background><MultiBinding Converter="{StaticResource AvatarAwareChatSurfaceBrushConverter}"><Binding Path="ChatAppearance.UseCharacterAvatarBackground" /><Binding Path="IsSceneChatActive" /><Binding Path="SelectedCharacter.AvatarPath" /><Binding Path="SelectedSceneCharacterA.AvatarPath" /><Binding Source="{StaticResource PanelBrush}" /></MultiBinding></Border.Background>
    <Border.Style>
        <Style TargetType="Border" BasedOn="{StaticResource SystemStatusCard}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSceneChatActive}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Border.Style>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource SheetSection}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
            <TextBlock Text="Участники" Style="{StaticResource SectionLabel}" />
            <Grid Margin="0,9,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48">
                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                    <TextBlock Text="{Binding SelectedSceneCharacterA.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" />
                    <Ellipse IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding SelectedSceneCharacterA.AvatarPath}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSceneCharacterA.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedSceneCharacterA.Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="58" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48" Height="48">
                    <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                    <TextBlock Text="{Binding SelectedSceneCharacterB.Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="White" />
                    <Ellipse IsHitTestVisible="False">
                        <Ellipse.Fill>
                            <ImageBrush ImageSource="{Binding SelectedSceneCharacterB.AvatarPath}" Stretch="UniformToFill" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding SelectedSceneCharacterB.Name}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedSceneCharacterB.Title}" Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            </StackPanel>
            </Border>
            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,14" />
            <Border Style="{StaticResource SheetSection}" Padding="12" Margin="0,0,0,12">
            <StackPanel>
            <TextBlock Text="Параметры группового разговора" Style="{StaticResource SectionLabel}" />
            <TextBlock Text="Название" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,9,0,3" />
            <TextBox Text="{Binding SelectedGroupConversation.Name, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Сценарий" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="Начальная ситуация: что происходит, где находятся участники и какие правила важны." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.Scenario, UpdateSourceTrigger=PropertyChanged}" ToolTip="Начальная ситуация и правила происходящего в разговоре." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Место" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="Например: фойе кинотеатра, кафе, кабинет, улица." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.Location, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Время" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="Например: вечер, первое сентября, после работы, начало сеанса." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.TimeContext, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Настроение" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="Общий эмоциональный тон: лёгкое любопытство, напряжение, радость и т. п." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.Mood, UpdateSourceTrigger=PropertyChanged}" />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Цель" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="К чему разговор должен естественно прийти; помогает модели не зацикливаться." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.Goal, UpdateSourceTrigger=PropertyChanged}" ToolTip="К чему должен естественно двигаться разговор; это помогает избегать зацикливания." />
            <StackPanel Orientation="Horizontal" Margin="0,9,0,3">
                <TextBlock Text="Общие отношения / контекст" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" />
                <ui:HelpHint Hint="Например: друзья, коллеги, незнакомцы, брат и сестра." />
            </StackPanel>
            <TextBox Text="{Binding SelectedGroupConversation.RelationshipContext, UpdateSourceTrigger=PropertyChanged}" ToolTip="Установившиеся отношения участников: друзья, коллеги, незнакомцы и т. п." AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" />
            <TextBlock Text="Следующий говорящий" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,9,0,3" />
            <ComboBox ItemsSource="{Binding SceneParticipants}" SelectedValuePath="Id" DisplayMemberPath="Name" SelectedValue="{Binding SelectedGroupConversation.NextCharacterId}" />
            <TextBlock Text="Пауза между репликами, сек" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" Margin="0,9,0,3" />
            <TextBox Text="{Binding SelectedGroupConversation.DelaySeconds, UpdateSourceTrigger=PropertyChanged}" TextAlignment="Center" />
            <CheckBox Content="Соблюдать рамки разговора" IsChecked="{Binding SelectedGroupConversation.EnforceConversationContract}" Margin="0,10,0,0" />
            <CheckBox Content="Развивать разговор и избегать повторов" IsChecked="{Binding SelectedGroupConversation.AdvanceAndAvoidRepetition}" Margin="0,8,0,0" ToolTip="Не позволяет повторять последние реплики; модель должна двигать разговор к цели естественными небольшими шагами." />
            <TextBlock Text="Включено: модель развивает ситуацию и не повторяет недавний диалог." Foreground="{StaticResource TextMutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="24,4,0,0" />
            <Button Content="Сохранить параметры" Command="{Binding SaveSceneCommand}" Style="{StaticResource SuccessButton}" Margin="0,10,0,0" />
            <Button Content="Удалить разговор" Command="{Binding DeleteSceneCommand}" Style="{StaticResource DangerButton}" Margin="0,7,0,0" />
            </StackPanel>
            </Border>
            <Expander Header="Контекст и общий Summary" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,12,0,0">
                <StackPanel Margin="0,7,0,0">
                    <TextBlock Text="{Binding SelectedGroupConversation.SummaryText}" Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Summary принадлежит только этому разговору и не изменяет другие разговоры персонажей." Foreground="{StaticResource TextMutedBrush}" FontSize="10" Margin="0,8,0,0" />
                </StackPanel>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Border>
</UserControl>
