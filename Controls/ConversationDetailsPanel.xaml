<UserControl x:Class="SoulExe.Controls.ConversationDetailsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:controls="clr-namespace:SoulExe.Controls">
    <UserControl.Resources><ui:AvatarAwareChatSurfaceBrushConverter x:Key="AvatarAwareChatSurfaceBrushConverter" /></UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource SystemStatusCard}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14,10">
            <Border.Background><MultiBinding Converter="{StaticResource AvatarAwareChatSurfaceBrushConverter}"><Binding Path="ChatAppearance.UseCharacterAvatarBackground" /><Binding Path="IsSceneChatActive" /><Binding Path="SelectedCharacter.AvatarPath" /><Binding Path="SelectedSceneCharacterA.AvatarPath" /><Binding Source="{StaticResource PanelBrush}" /></MultiBinding></Border.Background>
            <TextBlock Text="Информация" FontSize="12" FontWeight="SemiBold"
                       Foreground="{StaticResource TextSecondaryBrush}" />
        </Border>

        <controls:CharacterConversationDetailsView Grid.Row="2" />
        <controls:GroupConversationSettingsView Grid.Row="2" />
    </Grid>
</UserControl>
