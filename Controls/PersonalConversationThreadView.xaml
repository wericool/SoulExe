<UserControl x:Class="SoulExe.Controls.PersonalConversationThreadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SoulExe.ViewModels"
             xmlns:ui="clr-namespace:SoulExe"
             xmlns:views="clr-namespace:SoulExe.Views"
             xmlns:controls="clr-namespace:SoulExe.Controls">
    <UserControl.Resources>
        <ui:AvatarAwareChatSurfaceBrushConverter x:Key="AvatarAwareChatSurfaceBrushConverter" />
        <Style x:Key="ChatHeaderAction" TargetType="Button" BasedOn="{StaticResource CircleIconButton}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" ClipToBounds="True">
        <Border.Background>
            <MultiBinding Converter="{StaticResource AvatarAwareChatSurfaceBrushConverter}">
                <Binding Path="ChatAppearance.UseCharacterAvatarBackground" />
                <Binding Path="IsSceneChatActive" />
                <Binding Path="SelectedCharacter.AvatarPath" />
                <Binding Path="SelectedSceneCharacterA.AvatarPath" />
                <Binding Path="ChatAppearance.ChatBackgroundColor" />
            </MultiBinding>
        </Border.Background>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <Border Background="{StaticResource GlassPanelBrush}" BorderBrush="{StaticResource GlassBorderBrush}" BorderThickness="0,0,0,1" Padding="14,2">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" MinWidth="0" Cursor="Hand" MouseLeftButtonDown="ChatIdentity_OnMouseLeftButtonDown" ToolTip="Открыть карточку персонажа">
                        <Grid Width="40" Height="40"><Ellipse Fill="{StaticResource AccentSoftBrush}" /><TextBlock Text="{Binding SelectedCharacter.Initials}" FontSize="12" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse></Grid>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" MinWidth="0"><TextBlock Text="{Binding SelectedCharacter.Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SelectedChatLastMessageLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" /></StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="☰" Command="{x:Static views:ChatWorkspaceView.ShowConversationListCommand}" Style="{StaticResource ChatHeaderAction}" ToolTip="Диалоги" AutomationProperties.Name="Открыть список диалогов" Margin="0,0,6,0" />
                        <Button Content="ⓘ" Command="{x:Static views:ChatWorkspaceView.ShowConversationDetailsCommand}" Style="{StaticResource ChatHeaderAction}" ToolTip="Информация" AutomationProperties.Name="Открыть информацию о разговоре" Margin="0,0,6,0" />
                        <Button Content="⌕" Command="{Binding ToggleChatMessageSearchCommand}" Style="{StaticResource ChatHeaderAction}" ToolTip="Поиск" AutomationProperties.Name="Открыть поиск по сообщениям" Margin="0,0,6,0" />
                        <Button Content="…" Style="{StaticResource ChatHeaderAction}" ToolTip="Действия" AutomationProperties.Name="Действия с разговором" Click="MessageMenuButton_OnClick" Tag="{Binding}">
                            <Button.ContextMenu><ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom"><MenuItem Header="{Binding PlacementTarget.Tag.SelectedChatListItem.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleChatPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="✎  Переименовать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><Separator /><MenuItem Header="🗑  Удалить разговор" Style="{StaticResource ChatActionMenuItem}" Foreground="{StaticResource DangerHoverBrush}" Command="{Binding PlacementTarget.Tag.DeleteChatListItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Row="1">
                <ListBox x:Name="ChatMessagesList" ItemsSource="{Binding Messages}" Style="{StaticResource ConversationMessageList}" Padding="28,18,28,18" ScrollViewer.ScrollChanged="ChatMessagesScroll_OnScrollChanged" PreviewMouseWheel="ChatMessages_OnPreviewMouseWheel" PreviewKeyDown="ChatMessages_OnPreviewKeyDown" PreviewMouseDown="ChatMessages_OnPreviewMouseDown" PreviewMouseUp="ChatMessages_OnPreviewMouseUp">
                    <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource ConversationMessageListItem}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Focusable" Value="False" /></Style></ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                            <StackPanel>
                                <Border HorizontalAlignment="Center" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,4" Margin="0,12,0,8"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowDateSeparator}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="{Binding DateSeparatorLabel}" FontSize="10" Foreground="{StaticResource TextMutedBrush}" /></Border>
                                <Border x:Name="Bubble" HorizontalAlignment="Left" MaxWidth="620" Margin="0,4" Padding="14,10" CornerRadius="14" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,7">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left"><Border x:Name="Avatar" Width="22" Height="22" CornerRadius="11" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0"><Grid><TextBlock Text="{Binding AuthorInitials}" FontSize="8" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" /><Ellipse IsHitTestVisible="False"><Ellipse.Fill><ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" /></Ellipse.Fill></Ellipse></Grid></Border><TextBlock x:Name="Author" Text="{Binding AuthorName}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" /></StackPanel>
                                            <Canvas HorizontalAlignment="Stretch" VerticalAlignment="Stretch"><Button Canvas.Right="0" Canvas.Top="0" Content="…" Width="24" Height="24" Padding="0" FontSize="11" Click="MessageMenuButton_OnClick" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Действия с сообщением" AutomationProperties.Name="Действия с сообщением">
                                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource CircleIconButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, ElementName=Bubble}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                                                <Button.ContextMenu><ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom"><MenuItem Header="↪  Продолжить с этого сообщения" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ContinueFromMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="✎  Редактировать" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginEditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><Separator /><MenuItem Header="🗑  Удалить сообщение" Style="{StaticResource ChatActionMenuItem}" Foreground="{StaticResource DangerHoverBrush}" Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></Button.ContextMenu>
                                            </Button></Canvas>
                                        </Grid>
                                        <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" CornerRadius="9" Padding="9" Margin="0,0,0,7"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasThoughtContent}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel><Button Content="{Binding ThoughtToggleText}" Command="{Binding ToggleThoughtCommand}" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" Padding="0" HorizontalContentAlignment="Left" FontSize="10.5" /><TextBlock Text="{Binding ThoughtContent}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,6,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsThoughtExpanded}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></StackPanel></Border>
                                        <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Visible" /><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><DockPanel><TextBlock x:Name="Time" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1" /><ui:SelectableFormattedChatBox x:Name="MessageText" ContentText="{Binding VisibleContent}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" /></DockPanel><StackPanel Orientation="Horizontal" Margin="0,7,0,0"><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasResponseVariants}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><Button Content="◀" Command="{Binding DataContext.PreviousVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" /><TextBlock Text="{Binding CurrentVariantNumber}" Margin="5,0" FontSize="10" /><TextBlock Text="/" FontSize="10" /><TextBlock Text="{Binding VariantCount}" Margin="5,0" FontSize="10" /><Button Content="▶" Command="{Binding DataContext.NextVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" /></StackPanel></StackPanel>
                                        <StackPanel><StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style><TextBox Text="{Binding EditingContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="74" VerticalScrollBarVisibility="Auto" /><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0"><Button Content="Отмена" Command="{Binding DataContext.CancelEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" /><Button Content="Сохранить" Command="{Binding DataContext.SaveEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource AccentButton}" /></StackPanel></StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <DataTemplate.Triggers><DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True"><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" /><Setter TargetName="Bubble" Property="BorderThickness" Value="2" /></DataTrigger><DataTrigger Binding="{Binding IsUser}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" /><Setter TargetName="Bubble" Property="Background" Value="{Binding DataContext.ChatAppearance.UserBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentBrush}" /><Setter TargetName="MessageText" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" /><Setter TargetName="Author" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" /><Setter TargetName="Time" Property="Foreground" Value="{StaticResource ChatOutboundMetaBrush}" /></DataTrigger><DataTrigger Binding="{Binding IsDirector}" Value="True"><Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Center" /><Setter TargetName="Bubble" Property="Background" Value="{StaticResource ElevatedBrush}" /><Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource AccentSoftBrush}" /><Setter TargetName="Avatar" Property="Visibility" Value="Collapsed" /></DataTrigger></DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="390" Margin="24"><Border.Style><Style TargetType="Border" BasedOn="{StaticResource EmptyState}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding Messages.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel HorizontalAlignment="Center"><TextBlock Text="Начните разговор" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="Напишите сообщение или нажмите «Продолжить», чтобы персонаж начал первым." FontSize="11.5" Foreground="{StaticResource TextMutedBrush}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" /></StackPanel></Border>
                <Button x:Name="NewMessagesButton" Content="↓  К последнему" Click="NewMessagesButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18" Padding="14,8" Style="{StaticResource AccentButton}" Visibility="Collapsed" AutomationProperties.Name="Перейти к последнему сообщению" />
                <Button Content="Загрузить предыдущие сообщения" Command="{Binding LoadOlderChatMessagesCommand}" Click="LoadOlderMessagesButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource GhostButton}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasOlderChatMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style></Button>
            </Grid>
            <controls:ConversationComposerView Grid.Row="2" Tag="Personal" />
        </Grid>
    </Border>
</UserControl>
