<UserControl x:Class="SoulExe.Controls.PersonalConversationThreadView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:vm="clr-namespace:SoulExe.ViewModels"
              xmlns:ui="clr-namespace:SoulExe"
              xmlns:views="clr-namespace:SoulExe.Views"
              xmlns:controls="clr-namespace:SoulExe.Controls">
<Border Grid.Column="2" Background="{Binding ChatAppearance.ChatBackgroundColor}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="16" Padding="0" ClipToBounds="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Background="Transparent" Padding="8,76,12,4">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" MinWidth="0" Visibility="Collapsed">
                    <Grid Width="40" Height="40">
                        <Ellipse Fill="{StaticResource AccentSoftBrush}" />
                        <TextBlock Text="{Binding SelectedCharacter.Initials}" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Ellipse IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <ImageBrush ImageSource="{Binding SelectedCharacter.AvatarPath}" Stretch="UniformToFill" />
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessBrush}" Stroke="{StaticResource PanelBrush}" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                    </Grid>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center" MinWidth="0">
                        <TextBlock Text="{Binding SelectedCharacter.Name}" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding SelectedChatLastMessageLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
                    <TextBlock Text="{Binding SelectedChatHeaderTitle}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="0,0,8,0" />
                        <Button Content="в°" Command="{x:Static views:ChatWorkspaceView.ShowConversationListCommand}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="РћС‚РєСЂС‹С‚СЊ СЃРїРёСЃРѕРє РґРёР°Р»РѕРіРѕРІ" ToolTip="Р”РёР°Р»РѕРіРё" Margin="0,0,6,0" />
                        <Button Content="в“" Command="{x:Static views:ChatWorkspaceView.ShowConversationDetailsCommand}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="РћС‚РєСЂС‹С‚СЊ СЃРІРµРґРµРЅРёСЏ Рѕ СЂР°Р·РіРѕРІРѕСЂРµ" ToolTip="РРЅС„РѕСЂРјР°С†РёСЏ Рѕ СЂР°Р·РіРѕРІРѕСЂРµ" Margin="0,0,6,0" />
                        <Button Content="вЊ•" Command="{Binding ToggleChatMessageSearchCommand}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="РџРѕРёСЃРє РїРѕ СЃРѕРѕР±С‰РµРЅРёСЏРј" ToolTip="РџРѕРёСЃРє РїРѕ СЃРѕРѕР±С‰РµРЅРёСЏРј РІ СЌС‚РѕРј СЂР°Р·РіРѕРІРѕСЂРµ" Margin="0,0,6,0" />
                        <Button Content="..." Style="{StaticResource CircleIconButton}" AutomationProperties.Name="Р”РµР№СЃС‚РІРёСЏ СЃ СЂР°Р·РіРѕРІРѕСЂРѕРј" ToolTip="Р”РµР№СЃС‚РІРёСЏ СЃ СЂР°Р·РіРѕРІРѕСЂРѕРј" Click="MessageMenuButton_OnClick" Tag="{Binding}">
                        <Button.ContextMenu>
                            <ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                <MenuItem Header="{Binding PlacementTarget.Tag.SelectedChatListItem.PinMenuText, RelativeSource={RelativeSource AncestorType=ContextMenu}}" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ToggleChatPinnedCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="вњЋ  РџРµСЂРµРёРјРµРЅРѕРІР°С‚СЊ" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginRenameChatCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <MenuItem Header="пј‹  РќРѕРІС‹Р№ СЂР°Р·РіРѕРІРѕСЂ СЃ РїРµСЂСЃРѕРЅР°Р¶РµРј" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.CreateChatForCharacterCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                <Separator />
                                <MenuItem Header="рџ—‘  РЈРґР°Р»РёС‚СЊ СЂР°Р·РіРѕРІРѕСЂ" Style="{StaticResource ChatActionMenuItem}" Foreground="{StaticResource DangerHoverBrush}" Command="{Binding PlacementTarget.Tag.DeleteChatListItemCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.Tag.SelectedChatListItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="1" Panel.ZIndex="12" MaxWidth="340" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="20,14,20,0" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="12" Padding="12" Effect="{StaticResource AccentGlowEffect}">
            <Border.RenderTransform>
                <TranslateTransform Y="0" />
            </Border.RenderTransform>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChatMessageSearchOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18" />
                                        <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(TranslateTransform.Y)" From="-14" To="0" Duration="0:0:0.2">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Г—" Command="{Binding CloseChatMessageSearchCommand}" Style="{StaticResource CircleIconButton}" AutomationProperties.Name="Р—Р°РєСЂС‹С‚СЊ РїРѕРёСЃРє" ToolTip="Р—Р°РєСЂС‹С‚СЊ РїРѕРёСЃРє" />
                    <TextBlock Text="РџРѕРёСЃРє РІ РґРёР°Р»РѕРіРµ" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border Grid.Row="1" Background="{StaticResource InputBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="9" Margin="0,10,0,8" Padding="9,0">
                    <DockPanel>
                        <TextBlock Text="вЊ•" Foreground="{StaticResource TextMutedBrush}" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center" />
                        <TextBox Text="{Binding ChatMessageSearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" MinHeight="32" Padding="0" VerticalContentAlignment="Center" ToolTip="Р’РІРµРґРёС‚Рµ С‚РµРєСЃС‚ РґР»СЏ РїРѕРёСЃРєР° РїРѕ СЃРѕРѕР±С‰РµРЅРёСЏРј" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" MaxHeight="260" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding ChatMessageSearchResults}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageSearchResult}">
                                <Button Command="{Binding DataContext.SelectChatMessageSearchResultCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Background="Transparent" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="5,8" HorizontalContentAlignment="Stretch" ToolTip="РџРѕРґСЃРІРµС‚РёС‚СЊ РЅР°Р№РґРµРЅРЅРѕРµ СЃРѕРѕР±С‰РµРЅРёРµ РІ Р»РµРЅС‚Рµ">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Timestamp}" DockPanel.Dock="Right" FontSize="9.5" Foreground="{StaticResource TextMutedBrush}" />
                                            <TextBlock Text="{Binding DisplayAuthor}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource AccentHoverBrush}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Preview}" Margin="0,4,0,0" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="42" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <ListBox x:Name="ChatMessagesList" ItemsSource="{Binding Messages}" Style="{StaticResource ConversationMessageList}" ScrollViewer.ScrollChanged="ChatMessagesScroll_OnScrollChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="HorizontalAlignment" Value="Stretch" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                                <Setter Property="IsHitTestVisible" Value="True" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChatMessageViewModel}">
                                <StackPanel>
                                    <Border HorizontalAlignment="Center" Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="11" Padding="11,5" Margin="0,12,0,8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ShowDateSeparator}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding DateSeparatorLabel}" Foreground="{StaticResource TextMutedBrush}" FontSize="10.5" />
                                    </Border>
                                    <Border x:Name="MessageBubble" Margin="0,7" Padding="12,10" CornerRadius="{Binding DataContext.ChatAppearance.BubbleCornerRadius, RelativeSource={RelativeSource AncestorType=Window}}" Background="{Binding DataContext.ChatAppearance.AssistantBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" MaxWidth="{Binding DataContext.ChatAppearance.BubbleMaxWidth, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left">
                                        <StackPanel>
                                            <!-- Compact header: avatar, author and actions share one line. -->
                                            <DockPanel LastChildFill="True" Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Content="..." Style="{StaticResource CircleIconButton}" Width="26" Height="26" FontSize="11" FontWeight="Bold" Padding="0" Margin="8,-2,0,0" AutomationProperties.Name="Р”РµР№СЃС‚РІРёСЏ СЃ СЃРѕРѕР±С‰РµРЅРёРµРј" ToolTip="Р”РµР№СЃС‚РІРёСЏ СЃ СЃРѕРѕР±С‰РµРЅРёРµРј" Click="MessageMenuButton_OnClick" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                                                    <Button.ContextMenu>
                                                        <ContextMenu Style="{StaticResource ChatActionContextMenu}" Placement="Bottom" StaysOpen="False">
                                                            <MenuItem Header="в†Є  РџСЂРѕРґРѕР»Р¶РёС‚СЊ СЃ СЌС‚РѕРіРѕ СЃРѕРѕР±С‰РµРЅРёСЏ" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.ContinueFromMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <MenuItem Header="вњЋ  Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ" Style="{StaticResource ChatActionMenuItem}" Command="{Binding PlacementTarget.Tag.BeginEditMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            <Separator />
                                                            <MenuItem Header="рџ—‘  РЈРґР°Р»РёС‚СЊ СЃРѕРѕР±С‰РµРЅРёРµ" Style="{StaticResource ChatActionMenuItem}" Foreground="{StaticResource DangerHoverBrush}" Command="{Binding PlacementTarget.Tag.DeleteMessageCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Border x:Name="MessageAvatar" Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,7,0">
                                                        <Grid>
                                                            <TextBlock Text="{Binding AuthorInitials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8.5" FontWeight="Bold" Foreground="White" />
                                                            <Ellipse IsHitTestVisible="False">
                                                                <Ellipse.Fill>
                                                                    <ImageBrush ImageSource="{Binding AvatarPath}" Stretch="UniformToFill" />
                                                                </Ellipse.Fill>
                                                            </Ellipse>
                                                        </Grid>
                                                    </Border>
                                                    <TextBlock x:Name="MessageAuthor" Text="{Binding AuthorName}" FontWeight="SemiBold" FontSize="11.5" Foreground="{StaticResource AccentHoverBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Background="{StaticResource ElevatedBrush}" BorderBrush="{StaticResource AccentSoftBrush}" BorderThickness="1" CornerRadius="8" Padding="9" Margin="0,1,0,6">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasThoughtContent}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel>
                                                    <Button Content="{Binding ThoughtToggleText}" Command="{Binding ToggleThoughtCommand}" Background="Transparent" Foreground="{StaticResource AccentHoverBrush}" HorizontalContentAlignment="Left" Padding="2" FontSize="11" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding ThoughtContent}" TextWrapping="Wrap" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic" FontSize="12" Margin="3,7,3,0">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsThoughtExpanded}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <!-- The time occupies its own right column, so wrapped text cannot overlap it. -->
                                                <DockPanel LastChildFill="True" Margin="0,1,0,0">
                                                    <TextBlock x:Name="MessageTime" DockPanel.Dock="Right" Text="{Binding Time}" Foreground="{StaticResource TextMutedBrush}" FontSize="9" VerticalAlignment="Bottom" Margin="8,0,0,1" />
                                                    <ui:SelectableFormattedChatBox x:Name="MessageText" ContentText="{Binding VisibleContent}" Appearance="{Binding DataContext.ChatAppearance, RelativeSource={RelativeSource AncestorType=Window}}" Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,2,0" />
                                                </DockPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                    <StackPanel.Style>
                                                        <Style TargetType="StackPanel">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding HasResponseVariants}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </StackPanel.Style>
                                                    <Button Content="в—Ђ" Command="{Binding DataContext.PreviousVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" AutomationProperties.Name="РџСЂРµРґС‹РґСѓС‰РёР№ РІР°СЂРёР°РЅС‚ РѕС‚РІРµС‚Р°" />
                                                    <TextBlock Text="{Binding CurrentVariantNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0" />
                                                    <TextBlock Text="/" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding VariantCount}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="10" VerticalAlignment="Center" Margin="5,0" />
                                                    <Button Content="в–¶" Command="{Binding DataContext.NextVariantCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Padding="5,1" FontSize="10" AutomationProperties.Name="РЎР»РµРґСѓСЋС‰РёР№ РІР°СЂРёР°РЅС‚ РѕС‚РІРµС‚Р°" />
                                                </StackPanel>
                                            </StackPanel>
                                            <StackPanel>
                                                <StackPanel.Style>
                                                    <Style TargetType="StackPanel">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </StackPanel.Style>
                                                <TextBox Text="{Binding EditingContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="72" VerticalScrollBarVisibility="Auto" />
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                                    <Button Content="РћС‚РјРµРЅР°" Command="{Binding DataContext.CancelEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource GhostButton}" />
                                                    <Button Content="РЎРѕС…СЂР°РЅРёС‚СЊ" Command="{Binding DataContext.SaveEditMessageCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Style="{StaticResource AccentButton}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsSearchHighlighted}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}" />
                                        <Setter TargetName="MessageBubble" Property="BorderThickness" Value="2" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                        <Setter TargetName="MessageBubble" Property="HorizontalAlignment" Value="Right" />
                                        <Setter TargetName="MessageBubble" Property="Background" Value="{Binding DataContext.ChatAppearance.UserBubbleColor, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        <Setter TargetName="MessageBubble" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="MessageText" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                        <Setter TargetName="MessageAvatar" Property="Background" Value="{StaticResource AccentBrush}" />
                                        <Setter TargetName="MessageAuthor" Property="Foreground" Value="{StaticResource TextOnAccentBrush}" />
                                        <Setter TargetName="MessageTime" Property="Foreground" Value="{StaticResource ChatOutboundMetaBrush}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="{StaticResource TextMutedBrush}" Margin="24,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Messages.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
                РџРѕРєР° СЃРѕРѕР±С‰РµРЅРёР№ РЅРµС‚. РќР°С‡РЅРёС‚Рµ СЂР°Р·РіРѕРІРѕСЂ РїРµСЂРІС‹Рј СЃРѕРѕР±С‰РµРЅРёРµРј.
            </TextBlock>
            <Border Background="{Binding ChatAppearance.AssistantBubbleColor}" VerticalAlignment="Bottom" Margin="24,0,24,12">
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource ConversationTypingBubble}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAssistantTyping}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24" Height="24" CornerRadius="12" Background="{StaticResource AccentSoftBrush}" Margin="0,0,8,0">
                                <TextBlock Text="вЂ¦" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" />
                            </Border>
                            <TextBlock VerticalAlignment="Center" Foreground="{StaticResource TextSecondaryBrush}" FontStyle="Italic">
                                <Run Text="{Binding SelectedCharacter.Name}" />
                                <Run Text=" РїРµС‡Р°С‚Р°РµС‚вЂ¦" />
                            </TextBlock>
                        </StackPanel>
            </Border>
            <Button Content="Р—Р°РіСЂСѓР·РёС‚СЊ РїСЂРµРґС‹РґСѓС‰РёРµ СЃРѕРѕР±С‰РµРЅРёСЏ" Command="{Binding LoadOlderChatMessagesCommand}" Click="LoadOlderMessagesButton_OnClick" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,12,0,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource GhostButton}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers><DataTrigger Binding="{Binding HasOlderChatMessages}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
        <Button x:Name="NewMessagesButton" Grid.Row="1" Panel.ZIndex="11" Content="РќРѕРІС‹Рµ СЃРѕРѕР±С‰РµРЅРёСЏ" Click="NewMessagesButton_OnClick" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,20" Padding="14,8" Style="{StaticResource AccentButton}" Visibility="Collapsed" AutomationProperties.Name="РќРѕРІС‹Рµ СЃРѕРѕР±С‰РµРЅРёСЏ" ToolTip="РџРµСЂРµР№С‚Рё Рє РЅРѕРІС‹Рј СЃРѕРѕР±С‰РµРЅРёСЏРј" />
        <controls:ConversationComposerView Grid.Row="2" Tag="Personal" />
    </Grid>
</Border>
</UserControl>
