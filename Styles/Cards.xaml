<ResourceDictionary xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation">
    <Style x:Key="SettingsSectionCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardGradientBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="20" />
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>
    <Style x:Key="PreviewPanelCard" TargetType="Border" BasedOn="{StaticResource SettingsSectionCard}">
        <Setter Property="Padding" Value="18" />
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style x:Key="CardBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Surface" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,5" />
    </Style>
    <Style x:Key="AvatarCircle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource AccentSoftBrush}" />
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
    </Style>
</ResourceDictionary>
